#!/bin/bash
# Copy-only recovery of one preempted f4e31c3 big-tariff exact-CG task.
# Submit through launch_legacy_bigtariff_recovery.sh so both source and
# continuation commits, semantic job name, and isolated output directory are
# pinned.  The exact pricer holds a per-output flock for the whole run.
#SBATCH -J legacy-rec
#SBATCH -o src/cluster_logs/legacy_recovery/%x_%j.out
#SBATCH -e src/cluster_logs/legacy_recovery/%x_%j.err
#SBATCH --open-mode=append
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=2
#SBATCH --mem=40G
#SBATCH --partition=default_partition
#SBATCH -t 7-00:00:00
#SBATCH --requeue
#SBATCH --mail-type=REQUEUE,FAIL,TIME_LIMIT
#SBATCH --mail-user=nc437@cornell.edu

set -euo pipefail

fatal() { echo "[RECOVERY] FATAL: $*" >&2; exit 2; }

if [ "$#" -ne 4 ]; then
  fatal "usage: sbatch $0 TASK ARRAY_JOB LEGACY_COMMIT EXPECTED_COMMIT"
fi
TASK=$1
ARRAY_JOB=$2
LEGACY_COMMIT=$3
EXPECTED_COMMIT=$4
ROOT="${EVSP_DR_ROOT:-}"
LEGACY_ROOT="${EVSP_LEGACY_ROOT:-$HOME/EVSP-DR}"

[ -n "$ROOT" ] || fatal "EVSP_DR_ROOT was not exported by the launcher"
[ -d "$ROOT/src" ] || fatal "continuation root has no src/: $ROOT"
[ -d "$LEGACY_ROOT/src" ] || fatal "legacy root has no src/: $LEGACY_ROOT"
actual_commit=$(git -C "$ROOT" rev-parse HEAD)
source_commit=$(git -C "$LEGACY_ROOT" rev-parse HEAD)
[ "$actual_commit" = "$EXPECTED_COMMIT" ] \
  || fatal "continuation checkout drifted: expected $EXPECTED_COMMIT, found $actual_commit"
[ "$source_commit" = "$LEGACY_COMMIT" ] \
  || fatal "legacy checkout drifted: expected $LEGACY_COMMIT, found $source_commit"
git -C "$ROOT" diff --quiet || fatal "continuation checkout has tracked changes"
git -C "$ROOT" diff --cached --quiet \
  || fatal "continuation checkout has staged changes"

case "$TASK" in
  22) NAME="Practice_Custom_DutyUnion_k30_r2"; TAG="peak18";
      PRICE="hourly_prices_single_peak_18.csv" ;;
  24) NAME="Practice_Custom_DutyUnion_k30_r4"; TAG="peak18";
      PRICE="hourly_prices_single_peak_18.csv" ;;
  32) NAME="Practice_Custom_DutyUnion_k30_r2"; TAG="sek";
      PRICE="hourly_prices_transdev_sek.csv" ;;
  *) fatal "task $TASK is not one of the recoverable tasks 22,24,32" ;;
esac
CSV="duty_unions_big/${NAME}.csv"
SOURCE="$LEGACY_ROOT/src/results/tariff_big/${NAME}_${TAG}.json"
OUTDIR="$ROOT/src/results/legacy_recovery/job${ARRAY_JOB}/c${EXPECTED_COMMIT:0:12}/task${TASK}"
OUT="$OUTDIR/${NAME}_${TAG}.json"
mkdir -p "$OUTDIR"
command -v flock >/dev/null 2>&1 || fatal "flock is unavailable"
# Open the lock fd in append mode: an O_TRUNC open would erase the current
# owner's diagnostic record before this job even attempts (and loses) the
# flock race.  The kernel lock, not the file contents, decides ownership.
exec 9>>"$OUT.recovery.lock"
if ! flock -n 9; then
  echo "[RECOVERY] SKIP_LOCKED another migration/pricer owns $OUT"
  exit 0
fi
printf 'job=%s host=%s restart=%s output=%s\n' \
  "${SLURM_JOB_ID:-unknown}" "$(hostname)" \
  "${SLURM_RESTART_COUNT:-0}" "$OUT" >&9

echo "[RECOVERY] host=$(hostname) date=$(date '+%F %T') restart=${SLURM_RESTART_COUNT:-0}"
echo "[RECOVERY] task=$TASK cell=${NAME}_${TAG} source_commit=$source_commit continuation_commit=$actual_commit"
echo "[RECOVERY] source=$SOURCE"
echo "[RECOVERY] output=$OUT"

source /share/apps/software/anaconda3/etc/profile.d/conda.sh \
  || fatal "could not source Anaconda"
activated=""
for ENV in "${EVSP_CONDA_ENV:-}" /home/nc437/evsp_env evsp_env312 evsp312 evsp_env py312; do
  [ -n "$ENV" ] || continue
  if conda activate "$ENV" 2>/dev/null; then activated=$ENV; break; fi
done
[ -n "$activated" ] || fatal "no project conda environment could be activated"
python -c 'import sys; assert sys.version_info[:2] == (3, 12), sys.version' \
  || fatal "recovery campaign requires the validated Python 3.12 runtime"
echo "[RECOVERY] conda=$activated $(python -V 2>&1)"

export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export EVSP_EXPECTED_COMMIT="$EXPECTED_COMMIT"

MIGRATE=(
  python -u "$ROOT/src/migrate_legacy_exact_pool.py"
  --source-result "$SOURCE"
  --destination "$OUT"
  --source-data-dir "$LEGACY_ROOT/data"
  --destination-data-dir "$ROOT/data"
  --witness-root "$LEGACY_ROOT/src/results"
  --legacy-commit "$LEGACY_COMMIT"
  --slurm-array-job "$ARRAY_JOB"
  --slurm-task "$TASK"
)
for SOURCE_LOG in \
    "$LEGACY_ROOT/src/cg-bigtar_${ARRAY_JOB}_${TASK}.out" \
    "$LEGACY_ROOT/src/cg-bigtar_${ARRAY_JOB}_${TASK}.err"; do
  if [ -f "$SOURCE_LOG" ]; then
    MIGRATE+=(--source-log "$SOURCE_LOG")
  fi
done

# A read-only plan distinguishes "witness not available yet" from corruption.
# Missing evidence is a clean WAIT state; every other validation error fails.
PLAN_LOG=$(mktemp "${TMPDIR:-/tmp}/evsp_rec_${ARRAY_JOB}_${TASK}.XXXXXX")
trap 'rm -f "$PLAN_LOG"' EXIT
WAIT_MARKER="$OUTDIR/WAIT_NO_WITNESS.txt"
if ! "${MIGRATE[@]}" >"$PLAN_LOG" 2>&1; then
  cat "$PLAN_LOG"
  if grep -Eq 'no authenticated .* witness' "$PLAN_LOG"; then
    {
      echo "date=$(date '+%F %T')"
      echo "task=$TASK job=${SLURM_JOB_ID:-unknown}"
      cat "$PLAN_LOG"
    } >"$WAIT_MARKER"
    echo "[RECOVERY] WAIT_NO_WITNESS task=$TASK; rerun the launcher after a sibling terminal status exists"
    exit 0
  fi
  fatal "legacy migration preflight failed"
fi
cat "$PLAN_LOG"
rm -f "$WAIT_MARKER"
"${MIGRATE[@]}" --apply

if python "$ROOT/src/campaign_artifact_status.py" \
    --source "$OUT" --print-source --require-terminal >/dev/null 2>&1; then
  echo "[RECOVERY] terminal result already exists; nothing to resume"
  exit 0
fi

cd "$ROOT/src"
python -u exact_pricer_expanded.py \
  --csv "$CSV" \
  --prices_csv "$PRICE" \
  --soc-step 15 \
  --block-min 10 \
  --rc-eps 0.0001 \
  --max-iters 200000 \
  --stall-window-min 120 \
  --stall-rc-frac 0.05 \
  --stall-obj-frac 1e-5 \
  --checkpoint-every 25 \
  --snapshot-at-minutes 60,180,360,600,900,1440,2880,4320 \
  --resume \
  --out "$OUT"
