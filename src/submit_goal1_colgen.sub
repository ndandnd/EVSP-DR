#!/usr/bin/env bash
# Generic Unicorn column-generation job. Submit from the repository root.
#SBATCH --job-name=G1CG
#SBATCH --output=src/logs/G1_%x_%j.out
#SBATCH --error=src/logs/G1_%x_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --requeue

set -euo pipefail

if (( $# < 5 || $# > 6 )); then
    echo "Usage: sbatch src/submit_goal1_colgen.sub INSTANCE MODE ACTIVE_HOURS RUN_TAG MILESTONES [PRICES_CSV]" >&2
    exit 2
fi

INSTANCE=$1
MODE=$2
ACTIVE_HOURS=$3
RUN_TAG=$4
MILESTONES=$5
PRICES_CSV=${6:-hourly_prices_flat.csv}

if [[ ! "$RUN_TAG" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "RUN_TAG may contain only letters, digits, dot, underscore, and hyphen" >&2
    exit 2
fi
if [[ "$INSTANCE" == /* || "$INSTANCE" != *.csv ]]; then
    echo "INSTANCE must be a relative CSV path under data/: $INSTANCE" >&2
    exit 2
fi
IFS='/' read -r -a instance_parts <<< "$INSTANCE"
for instance_part in "${instance_parts[@]}"; do
    if [[ -z "$instance_part" || "$instance_part" == "." || "$instance_part" == ".." ]]; then
        echo "INSTANCE contains an unsafe path component: $INSTANCE" >&2
        exit 2
    fi
done

case "$MODE" in
    NO_CHEAT|CHEAT|GREEDY|MATCHING) ;;
    *) echo "MODE must be NO_CHEAT, CHEAT, GREEDY, or MATCHING; got $MODE" >&2; exit 2 ;;
esac

REPO_ROOT=${EVSP_REPO_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}
if [[ ! -f "$REPO_ROOT/src/run_ex_unicorn.py" ]]; then
    echo "EVSP_REPO_ROOT does not identify a checkout: $REPO_ROOT" >&2
    exit 2
fi

CONDA_SH=${EVSP_CONDA_SH:-/share/apps/software/anaconda3/etc/profile.d/conda.sh}
CONDA_ENV=${EVSP_CONDA_ENV:-/home/nc437/evsp_env}
if [[ ! -f "$CONDA_SH" ]]; then
    echo "Missing conda setup: $CONDA_SH (override EVSP_CONDA_SH)" >&2
    exit 2
fi
source "$CONDA_SH"
conda activate "$CONDA_ENV"

if [[ -z "${GRB_LICENSE_FILE:-}" && -f /share/apps/software/gurobi/gurobi.lic ]]; then
    export GRB_LICENSE_FILE=/share/apps/software/gurobi/gurobi.lic
fi
unset LM_LICENSE_FILE || true
export PYTHONUNBUFFERED=1

cd "$REPO_ROOT"
mkdir -p src/logs src/results

echo "[JOB] start          : $(date --iso-8601=seconds 2>/dev/null || date)"
echo "[JOB] host           : $(hostname)"
echo "[JOB] slurm job      : ${SLURM_JOB_ID:-none}"
echo "[JOB] commit         : $(git rev-parse HEAD)"
echo "[JOB] branch         : $(git branch --show-current)"
echo "[JOB] instance       : $INSTANCE"
echo "[JOB] mode           : $MODE"
echo "[JOB] active hours   : $ACTIVE_HOURS (0 means no Python-side limit)"
echo "[JOB] milestones     : $MILESTONES"
echo "[JOB] prices         : $PRICES_CSV"
echo "[JOB] run tag        : $RUN_TAG"
python --version

MAX_LABELS=${EVSP_MAX_LABELS:-100000}
PRICING_TIERS=${EVSP_PRICING_TIERS:-${MAX_LABELS}:500,${MAX_LABELS}:3000}
PRICING_WALL=${EVSP_PRICING_WALL_PER_ITER:-6000}
STAGNATION_WINDOW=${EVSP_STAGNATION_WINDOW:-999999}
IMPROVEMENT_BOUND=${EVSP_IMPROVEMENT_BOUND:--1}
KBEST=${EVSP_KBEST:-150}
MIN_TRIPS=${EVSP_MIN_TRIPS_PER_ROUTE:-1}
MASTER_TIME_LIMIT=${EVSP_MASTER_TIME_LIMIT:-120}
PRICE_TAG=${EVSP_PRICE_TAG:-${PRICES_CSV##*/}}
PRICE_TAG=${PRICE_TAG%.csv}
MASTER_BACKEND=${EVSP_MASTER_BACKEND:-scipy}
case "$MASTER_BACKEND" in
    scipy|gurobi) ;;
    *) echo "EVSP_MASTER_BACKEND must be scipy or gurobi; got $MASTER_BACKEND" >&2; exit 2 ;;
esac
QUEUE_ORDER=${EVSP_QUEUE_ORDER:-reduced_cost_bound}
case "$QUEUE_ORDER" in
    time|reduced_cost|reduced_cost_bound|start_fair_bound) ;;
    *) echo "EVSP_QUEUE_ORDER must be time, reduced_cost, reduced_cost_bound, or start_fair_bound; got $QUEUE_ORDER" >&2; exit 2 ;;
esac
PRICING_OUTPUT_SELECTION=${EVSP_PRICING_OUTPUT_SELECTION:-reduced_cost}
case "$PRICING_OUTPUT_SELECTION" in
    reduced_cost|diversified) ;;
    *) echo "EVSP_PRICING_OUTPUT_SELECTION must be reduced_cost or diversified; got $PRICING_OUTPUT_SELECTION" >&2; exit 2 ;;
esac
DOMINANCE_MODE=${EVSP_DOMINANCE_MODE:-resource}
case "$DOMINANCE_MODE" in
    resource|incidence_diverse) ;;
    *) echo "EVSP_DOMINANCE_MODE must be resource or incidence_diverse; got $DOMINANCE_MODE" >&2; exit 2 ;;
esac
MAX_TRIP2TRIP=${EVSP_MAX_TRIP2TRIP:-57}
MAX_CHARGE2TRIP=${EVSP_MAX_CHARGE2TRIP:-1560}
MAX_SUCCESSOR_TARGETS=${EVSP_MAX_SUCCESSOR_TARGETS:-64}
echo "[JOB] trip gap cap   : $MAX_TRIP2TRIP minutes"

preflight_command=(
    python -u src/unicorn_preflight.py
    --csv "$INSTANCE"
    --prices_csv "$PRICES_CSV"
    --mode "$MODE"
)
if [[ "$MASTER_BACKEND" == "scipy" ]]; then
    preflight_command+=(--skip_gurobi)
fi
"${preflight_command[@]}"

INSTANCE_STEM=${INSTANCE##*/}
INSTANCE_STEM=${INSTANCE_STEM%.csv}
INSTANCE_KEY=${INSTANCE%.csv}
INSTANCE_KEY=${INSTANCE_KEY//\//_}

# Refuse two jobs that would append to the same checkpoint/stats files.  The
# lock is released automatically if the allocation exits or is cancelled.
LOCK_PATH="src/results/.lock_${INSTANCE_KEY}_${MODE}_${RUN_TAG}.lock"
if ! command -v flock >/dev/null 2>&1; then
    echo "flock is required to protect checkpoint resumes from concurrent writers" >&2
    exit 127
fi
exec 9>"$LOCK_PATH"
if ! flock -n 9; then
    echo "Another job is already using instance=$INSTANCE mode=$MODE tag=$RUN_TAG" >&2
    exit 75
fi

if [[ -n "${EVSP_RESUME_CKPT:-}" ]]; then
    if [[ ! -f "$EVSP_RESUME_CKPT" ]]; then
        echo "EVSP_RESUME_CKPT not found: $EVSP_RESUME_CKPT" >&2
        exit 2
    fi
    RESUME_CKPT=$EVSP_RESUME_CKPT
    export RESUME_CKPT
    echo "[JOB] resume         : explicit $RESUME_CKPT"
elif [[ "${EVSP_AUTO_RESUME:-1}" == "1" ]]; then
    RESUME_CKPT=$(find src/results -type f \
        -name "ckpt_latest_${INSTANCE_STEM}_${MODE}_*_${RUN_TAG}_g300_${KBEST}cols.json" \
        -print 2>/dev/null | xargs -r ls -t 2>/dev/null | head -n 1 || true)
    if [[ -n "$RESUME_CKPT" ]]; then
        export RESUME_CKPT
        echo "[JOB] resume         : $RESUME_CKPT"
    else
        unset RESUME_CKPT || true
        echo "[JOB] resume         : fresh run"
    fi
else
    unset RESUME_CKPT || true
    echo "[JOB] resume         : disabled by EVSP_AUTO_RESUME=0"
fi

command=(
    python -u src/run_ex_unicorn.py
    --csv "$INSTANCE"
    --G 300
    --kbest "$KBEST"
    --max_labels "$MAX_LABELS"
    --min_trips_per_route "$MIN_TRIPS"
    --master_backend "$MASTER_BACKEND"
    --queue_order "$QUEUE_ORDER"
    --pricing_output_selection "$PRICING_OUTPUT_SELECTION"
    --dominance_mode "$DOMINANCE_MODE"
    --max_trip2trip "$MAX_TRIP2TRIP"
    --max_charge2trip "$MAX_CHARGE2TRIP"
    --max_successor_charge_targets "$MAX_SUCCESSOR_TARGETS"
    --master_time_limit "$MASTER_TIME_LIMIT"
    --pricing_tiers "$PRICING_TIERS"
    --pricing_wall_per_iter "$PRICING_WALL"
    --stagnation_window "$STAGNATION_WINDOW"
    --improvement_bound "$IMPROVEMENT_BOUND"
    --active_time_limit_hours "$ACTIVE_HOURS"
    --milestones_hours "$MILESTONES"
    --prices_csv "$PRICES_CSV"
    --price_tag "$PRICE_TAG"
    --run_tag "$RUN_TAG"
    --skip_final_mip
)
case "$MODE" in
    CHEAT)  command+=(--cheat) ;;
    GREEDY) command+=(--greedy) ;;
    MATCHING) command+=(--matching) ;;
esac
if [[ "${EVSP_ALLOW_UNSAFE_RESUME:-0}" == "1" ]]; then
    command+=(--allow_unsafe_resume)
fi

set +e
"${command[@]}"
exit_code=$?
set -e

echo "[JOB] end            : $(date --iso-8601=seconds 2>/dev/null || date)"
echo "[JOB] exit code      : $exit_code"
exit "$exit_code"
