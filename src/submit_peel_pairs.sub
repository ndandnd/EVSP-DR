#!/bin/bash
# Peel-and-price duty-pair sweep: 20 pairs x {lookahead, lp} x {0.04h, 0.15h stages}.
#
# Submit (pairs.txt is auto-generated by task 1 if missing):
#   export EVSP_DR_ROOT=$HOME/EVSP-DR        # wherever this checkout lives
#   export EVSP_CONDA_ENV=/home/nc437/evsp_env   # optional override
#   cd $EVSP_DR_ROOT/src && sbatch submit_peel_pairs.sub
#SBATCH -J PEELPAIR
#SBATCH -o %x_%A_%a.out
#SBATCH -e %x_%A_%a.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --mem=8G
#SBATCH --partition=default_partition
#SBATCH -t 04:00:00
#SBATCH --cpus-per-task=2
#SBATCH --array=1-80
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=nc437@cornell.edu

set -uo pipefail

fatal() { echo "[FATAL task ${SLURM_ARRAY_TASK_ID:-?}] $*" >&2; exit 1; }

echo "[diag] host=$(hostname) date=$(date '+%F %T')"

ROOT="${EVSP_DR_ROOT:-$HOME/EVSP-DR}"
[ -d "$ROOT/src" ] || fatal "EVSP_DR_ROOT=$ROOT has no src/ dir. export EVSP_DR_ROOT=<checkout> before sbatch."
cd "$ROOT/src"

source /share/apps/software/anaconda3/etc/profile.d/conda.sh \
  || fatal "could not source anaconda profile"

# Try the configured env, then common names from the py312 migration.
activated=""
for ENV in "${EVSP_CONDA_ENV:-}" /home/nc437/evsp_env evsp_env312 evsp312 evsp_env py312; do
  [ -n "$ENV" ] || continue
  if conda activate "$ENV" 2>/dev/null; then activated="$ENV"; break; fi
done
[ -n "$activated" ] || { conda env list >&2; fatal "no conda env worked; export EVSP_CONDA_ENV=<env>"; }
echo "[diag] conda env: $activated  python: $(command -v python)  $(python -V 2>&1)"
python -c "import pandas, scipy" 2>/dev/null \
  || fatal "env '$activated' lacks pandas/scipy; export EVSP_CONDA_ENV=<env with deps>"

set -e
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

PAIRS_FILE="$ROOT/data/duty_pairs/pairs.txt"
if [ ! -s "$PAIRS_FILE" ]; then
  if [ "$SLURM_ARRAY_TASK_ID" -eq 1 ]; then
    echo "[diag] pairs.txt missing; task 1 generating instances"
    python make_duty_pair_instances.py --pairs 20
  else
    for _ in $(seq 1 60); do [ -s "$PAIRS_FILE" ] && break; sleep 5; done
  fi
fi
[ -s "$PAIRS_FILE" ] || fatal "missing $PAIRS_FILE (run: python make_duty_pair_instances.py --pairs 20)"

N_PAIRS=$(wc -l < "$PAIRS_FILE")
TASK0=$((SLURM_ARRAY_TASK_ID - 1))
PAIR_IDX=$((TASK0 % N_PAIRS))
TMP=$((TASK0 / N_PAIRS))
PICK_IDX=$((TMP % 2))
BUDGET_IDX=$((TMP / 2))

CSV=$(sed -n "$((PAIR_IDX + 1))p" "$PAIRS_FILE")
PICKS=(lookahead lp)
BUDGETS=(0.04 0.15)
SECS=(60 120)

PICK=${PICKS[$PICK_IDX]}
BUDGET=${BUDGETS[$BUDGET_IDX]}
SEC=${SECS[$BUDGET_IDX]}
TAG="peelpair_${SLURM_ARRAY_TASK_ID}_${PICK}_b${BUDGET/./p}"

echo "[SLURM $SLURM_ARRAY_TASK_ID] $CSV pick=$PICK stage=${BUDGET}h pricing=${SEC}s"
python -u run_peel_and_price.py \
  --csv "duty_pairs/${CSV}" \
  --initializer nocheat \
  --pick "$PICK" \
  --stage-active-hours "$BUDGET" \
  --pricing-seconds "$SEC" \
  --run-tag "$TAG"
