#!/bin/bash
# Phase-2 pilot: exact CG under time-varying charging prices.
# Instances: k08_r3, k13_r2 (duty_unions) and k15_r6 (duty_unions_big).
# Prices: flat control + single-peak 08/12/18 Gaussian curves.
# 3 instances x 4 curves = 12 tasks, coarse grid, tolerance-terminated
# (rc-eps 5). Deliverable per task: pool + final LP + charging events, from
# which charging-time histograms show (or refute) peak avoidance — the
# behavior the old stag-batch Gantt plots suggested, now with delayed-start
# charging native to the network.
#
# From the repository root, validate first and submit through the named launcher:
#   python src/slurm_campaign.py submit peaks
#   python src/slurm_campaign.py submit peaks --submit
#SBATCH -J XP-UNNAMED
#SBATCH -o %x_%A_%a.out
#SBATCH -e %x_%A_%a.err
#SBATCH --open-mode=append
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --mem=24G
#SBATCH --partition=default_partition
#SBATCH -t 12:00:00
#SBATCH --cpus-per-task=2
#SBATCH --array=1-12
#SBATCH --requeue
#SBATCH --mail-type=REQUEUE,FAIL
#SBATCH --mail-user=nc437@cornell.edu

set -uo pipefail

fatal() { echo "[FATAL task ${SLURM_ARRAY_TASK_ID:-?}] $*" >&2; exit 1; }

echo "[diag] host=$(hostname) date=$(date '+%F %T')"

ROOT="${EVSP_DR_ROOT:-$HOME/EVSP-DR}"
[ -d "$ROOT/src" ] || fatal "EVSP_DR_ROOT=$ROOT has no src/ dir"
cd "$ROOT/src"

source /share/apps/software/anaconda3/etc/profile.d/conda.sh \
  || fatal "could not source anaconda profile"
activated=""
for ENV in "${EVSP_CONDA_ENV:-}" /home/nc437/evsp_env evsp_env312 evsp312 evsp_env py312; do
  [ -n "$ENV" ] || continue
  if conda activate "$ENV" 2>/dev/null; then activated="$ENV"; break; fi
done
[ -n "$activated" ] || { conda env list >&2; fatal "no conda env worked"; }
echo "[diag] conda env: $activated  $(python -V 2>&1)"

set -e
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

if ! task_config=$(
  python slurm_campaign.py task peaks --task "$SLURM_ARRAY_TASK_ID"
); then
  fatal "could not resolve the tracked peak task manifest"
fi
IFS=$'\t' read -r CSV PRICE TAG JOB_NAME <<< "$task_config"
[ -n "$CSV" ] && [ -n "$PRICE" ] && [ -n "$TAG" ] && [ -n "$JOB_NAME" ] \
  || fatal "tracked peak task manifest returned an empty field"

# The named launcher assigns this before submission. Repeat the update so a
# direct/requeued array task is still identifiable in squeue and sacct.
if command -v scontrol >/dev/null 2>&1; then
  scontrol update \
    JobId="${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}" \
    JobName="$JOB_NAME" \
    || echo "[WARN] could not update Slurm job name to $JOB_NAME" >&2
fi

NAME=$(basename "$CSV" .csv)

[ -f "$ROOT/data/$CSV" ] || fatal "$CSV missing — campaign preflight should have stopped submission"
[ -f "$ROOT/data/$PRICE" ] || fatal "$PRICE missing"

CAMPAIGN_TAG="${EVSP_SLURM_RUN_TAG:-direct_${SLURM_ARRAY_JOB_ID}}"
[[ "$CAMPAIGN_TAG" =~ ^[A-Za-z0-9_.-]+$ ]] \
  || fatal "unsafe EVSP_SLURM_RUN_TAG=$CAMPAIGN_TAG"
OUTDIR="$ROOT/src/results/exact_peaks/$CAMPAIGN_TAG"
mkdir -p "$OUTDIR"

echo "[SLURM $SLURM_ARRAY_TASK_ID] $NAME under $TAG"
python -u exact_pricer_expanded.py \
  --csv "$CSV" \
  --prices_csv "$PRICE" \
  --soc-step 15 \
  --block-min 10 \
  --rc-eps 5 \
  --max-iters 200000 \
  --wall-limit-s 39600 \
  --checkpoint-every 25 \
  --resume \
  --out "$OUTDIR/${NAME}_${TAG}.json"
