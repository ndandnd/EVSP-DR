#!/bin/bash
# Overnight exact CG at scale: k = 20, 30, 40 duty unions, coarse grid only
# (15 kWh / 10 min). Graceful wall-limit stop + periodic JSON checkpoints, so
# a job that cannot certify within the window still reports weight/objective
# trajectory and stop_reason.
#
#   export EVSP_DR_ROOT=$HOME/EVSP-DR
#   cd $EVSP_DR_ROOT/src
#   python make_duty_pair_instances.py --union-sizes 20,30,40 --per-size 2 \
#       --union-dir-name duty_unions_big
#   sbatch submit_exact_big.sub
#SBATCH -J cg-big-flat
#SBATCH -o %x_%A_%a.out
#SBATCH -e %x_%A_%a.err
#SBATCH --open-mode=append
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --mem=40G
#SBATCH --partition=default_partition
#SBATCH -t 23:00:00
#SBATCH --cpus-per-task=2
#SBATCH --array=1-6
#SBATCH --requeue
#SBATCH --mail-type=REQUEUE,FAIL
#SBATCH --mail-user=nc437@cornell.edu

set -uo pipefail

fatal() { echo "[FATAL task ${SLURM_ARRAY_TASK_ID:-?}] $*" >&2; exit 1; }

echo "[diag] host=$(hostname) date=$(date '+%F %T')"

ROOT="${EVSP_DR_ROOT:-$HOME/EVSP-DR}"
[ -d "$ROOT/src" ] || fatal "EVSP_DR_ROOT=$ROOT has no src/ dir"
cd "$ROOT/src"

source /share/apps/software/anaconda3/etc/profile.d/conda.sh \
  || fatal "could not source anaconda profile"
activated=""
for ENV in "${EVSP_CONDA_ENV:-}" /home/nc437/evsp_env evsp_env312 evsp312 evsp_env py312; do
  [ -n "$ENV" ] || continue
  if conda activate "$ENV" 2>/dev/null; then activated="$ENV"; break; fi
done
[ -n "$activated" ] || { conda env list >&2; fatal "no conda env worked"; }
echo "[diag] conda env: $activated  $(python -V 2>&1)"
python -c "import pandas, scipy" 2>/dev/null || fatal "env lacks pandas/scipy"

set -e
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

UNIONS_FILE="$ROOT/data/duty_unions_big/unions.txt"
if [ ! -s "$UNIONS_FILE" ]; then
  if [ "$SLURM_ARRAY_TASK_ID" -eq 1 ]; then
    python make_duty_pair_instances.py --union-sizes 20,30,40 --per-size 2 \
      --union-dir-name duty_unions_big
  else
    for _ in $(seq 1 60); do [ -s "$UNIONS_FILE" ] && break; sleep 5; done
  fi
fi
[ -s "$UNIONS_FILE" ] || fatal "missing $UNIONS_FILE"

CSV=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$UNIONS_FILE")
[ -n "$CSV" ] || fatal "no line $SLURM_ARRAY_TASK_ID in $UNIONS_FILE"
K=$(echo "$CSV" | sed -E 's/.*_k0*([0-9]+)_r.*/\1/')

OUTDIR="$ROOT/src/results/exact_big"
mkdir -p "$OUTDIR"
BASE="${CSV%.csv}_soc15_b10"

# Overrides from the sbatch line:
#   EXACT_WALL_S=165600 sbatch -t 47:00:00 submit_exact_big.sub   # run longer
#   EXACT_G=240 EXACT_KW=220 sbatch submit_exact_big.sub          # real battery
#   EXACT_RESERVE=0.2 sbatch submit_exact_big.sub                 # FDL min SOC
#   EXACT_RC_EPS=5 sbatch submit_exact_big.sub                    # tolerance-
#       terminated production run (NOT an exact certificate)
WALL="${EXACT_WALL_S:-79200}"
GKWH="${EXACT_G:-300}"
CKW="${EXACT_KW:-300}"
RESERVE="${EXACT_RESERVE:-0.0}"
RCEPS="${EXACT_RC_EPS:-0.0001}"

echo "[SLURM $SLURM_ARRAY_TASK_ID] $CSV k=$K coarse grid, wall-limit ${WALL}s, G=${GKWH} kWh @ ${CKW} kW, reserve=${RESERVE}, rc-eps=${RCEPS}"
# --resume reloads the column journal, so a requeued or relaunched task
# continues from its persisted pool instead of starting over.
python -u exact_pricer_expanded.py \
  --csv "duty_unions_big/${CSV}" \
  --prices_csv hourly_prices_flat.csv \
  --soc-step 15 \
  --block-min 10 \
  --g-kwh "$GKWH" \
  --charge-kw "$CKW" \
  --min-soc-frac "$RESERVE" \
  --rc-eps "$RCEPS" \
  --max-iters 200000 \
  --wall-limit-s "$WALL" \
  --checkpoint-every 25 \
  --resume \
  --out "$OUTDIR/${BASE}_g${GKWH}_res${RESERVE}.json"
