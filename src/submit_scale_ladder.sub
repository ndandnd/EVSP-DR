#!/bin/bash
# Hash-approved worker for one scale-ladder array task.

set -euo pipefail

fatal() {
  echo "[SCALE-LADDER] FATAL: $*" >&2
  exit 2
}

[[ "$#" -eq 8 ]] \
  || fatal "usage: worker PLAN PLAN_SHA GROUP PYTHON PY_SHA SCONTROL SC_SHA"
PLAN=$1
PLAN_SHA=$2
GROUP=$3
PYTHON=$4
PYTHON_SHA=$5
SCONTROL=$6
SCONTROL_SHA=$7
# Eighth argument is reserved for forward-compatible worker identity.
WORKER_TOKEN=$8
ROOT=$(cd "$(dirname "$0")/.." && pwd)

[[ "$PYTHON" == /* && -x "$PYTHON" ]] || fatal "invalid Python"
[[ "$(sha256sum "$PYTHON" | awk '{print $1}')" == "$PYTHON_SHA" ]] \
  || fatal "Python hash mismatch"
[[ "$SCONTROL" == /* && -x "$SCONTROL" ]] || fatal "invalid scontrol"
[[ "$(sha256sum "$SCONTROL" | awk '{print $1}')" == "$SCONTROL_SHA" ]] \
  || fatal "scontrol hash mismatch"
[[ "$(sha256sum "$PLAN" | awk '{print $1}')" == "$PLAN_SHA" ]] \
  || fatal "approved plan hash mismatch"
unset PYTHONPATH || true
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1

TASK=${SLURM_ARRAY_TASK_ID:-}
[[ "$TASK" =~ ^[0-9]+$ ]] || fatal "array task ID missing"

readarray -t FIELDS < <("$PYTHON" -I -B - "$PLAN" "$GROUP" "$TASK" <<'PY'
import json,sys
plan=json.load(open(sys.argv[1]))
group=sys.argv[2]
index=int(sys.argv[3])
keys=(plan.get("task_groups") or {}).get(group)
if not isinstance(keys,list) or not 0 <= index < len(keys):
    raise SystemExit("invalid group/task mapping")
matches=[job for job in plan["jobs"] if job["job_key"]==keys[index]]
if len(matches)!=1:
    raise SystemExit("mapped task does not identify exactly one job")
job=matches[0]
for value in (
    plan["checkout_identity"]["commit"],
    plan["worker_sha256"],
    plan["tariff"]["primary_tariff_sha256"],
    job["job_key"], job["job_name"], job["phase"], job["arm"],
    job["scale"], job["selection_replicate"], job["cg_replicate"],
    job["budget_s"], job["threads"],
    job["instance"]["path"], job["instance"]["instance_file_sha256"],
    job["instance"]["relative_path"], job["output"],
    job["progress_dir"], job["telemetry"],
):
    print("" if value is None else value)
PY
) || fatal "could not resolve task"

EXPECTED_COMMIT=${FIELDS[0]}
EXPECTED_WORKER_SHA=${FIELDS[1]}
TARIFF_SHA=${FIELDS[2]}
JOB_KEY=${FIELDS[3]}
JOB_NAME=${FIELDS[4]}
PHASE=${FIELDS[5]}
ARM=${FIELDS[6]}
SCALE=${FIELDS[7]}
SELECTION_REP=${FIELDS[8]}
CG_REP=${FIELDS[9]}
BUDGET=${FIELDS[10]}
THREADS=${FIELDS[11]}
INSTANCE=${FIELDS[12]}
INSTANCE_SHA=${FIELDS[13]}
INSTANCE_REL=${FIELDS[14]}
OUTPUT=${FIELDS[15]}
PROGRESS=${FIELDS[16]}
TELEMETRY=${FIELDS[17]}

[[ "$WORKER_TOKEN" == "$EXPECTED_WORKER_SHA" ]] \
  || fatal "worker token mismatch"
[[ "$(sha256sum "$0" | awk '{print $1}')" == "$EXPECTED_WORKER_SHA" ]] \
  || fatal "worker hash mismatch"
[[ "$(git -C "$ROOT" rev-parse HEAD)" == "$EXPECTED_COMMIT" ]] \
  || fatal "commit mismatch"
if git -C "$ROOT" symbolic-ref -q HEAD >/dev/null 2>&1; then
  fatal "checkout must be detached"
fi
[[ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]] \
  || fatal "tracked checkout modifications"
UNTRACKED_IMPORTS=$(
  git -C "$ROOT" status --porcelain --untracked-files=all \
  | awk '$1=="??" && $2 ~ /\.(py|pyc|pyo|so|pth)$/ {print $2}'
)
[[ -z "$UNTRACKED_IMPORTS" ]] || fatal "untracked importable runtime code"
while IFS=$'\t' read -r RELATIVE EXPECTED; do
  [[ "$(sha256sum "$ROOT/$RELATIVE" | awk '{print $1}')" == "$EXPECTED" ]] \
    || fatal "reviewed code hash mismatch: $RELATIVE"
done < <("$PYTHON" -I -B - "$PLAN" <<'PY'
import json,sys
plan=json.load(open(sys.argv[1]))
for path,digest in sorted(plan["code_hashes"].items()):
    print(f"{path}\t{digest}")
PY
)
OBSERVED_ENV=$(
  "$PYTHON" -I -B "$ROOT/src/tariff_response_environment.py"
) || fatal "approved environment unavailable"
"$PYTHON" -I -B - "$PLAN" "$OBSERVED_ENV" <<'PY' \
  || fatal "worker environment differs"
import json,sys
if json.loads(sys.argv[2]) != json.load(open(sys.argv[1]))["python_identity"]:
    raise SystemExit("environment mismatch")
PY
[[ "$(sha256sum "$INSTANCE" | awk '{print $1}')" == "$INSTANCE_SHA" ]] \
  || fatal "instance hash mismatch"
[[ "$(sha256sum "$ROOT/data/hourly_prices_flat.csv" | awk '{print $1}')" == \
   "$TARIFF_SHA" ]] || fatal "historical flat tariff hash mismatch"

"$SCONTROL" update \
  JobId="${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}" \
  JobName="$JOB_NAME" || fatal "semantic job-name update failed"

"$PYTHON" -B "$ROOT/src/install_exact_cg_profile_input.py" \
  --source "$INSTANCE" --data-root "$ROOT/data" \
  --relative "$INSTANCE_REL" --sha256 "$INSTANCE_SHA" \
  || fatal "instance installation failed"

if [[ "$PHASE" == "CG" ]]; then
  [[ ! -e "$OUTPUT.worker-completion.json" ]] \
    || fatal "completed CG already exists"
else
  [[ ! -e "$OUTPUT" ]] || fatal "output exists"
fi
if [[ -n "$PROGRESS" ]]; then
  [[ ! -e "$PROGRESS" ]] || fatal "progress exists"
fi
mkdir -p "$(dirname "$OUTPUT")"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export EVSP_EXPECTED_COMMIT="$EXPECTED_COMMIT"
export EVSP_REQUIRE_DETACHED=1

command=()
case "$PHASE" in
  SEED)
    command=(
      "$PYTHON" -B "$ROOT/src/prepare_scale_ladder_known_partition.py"
      --instance "$ROOT/data/$INSTANCE_REL"
      --instance-sha256 "$INSTANCE_SHA"
      --out "$OUTPUT"
    )
    ;;
  CG)
    SNAPSHOTS=$(
      "$PYTHON" -I -B - "$PLAN" "$JOB_KEY" <<'PY'
import json,sys
plan=json.load(open(sys.argv[1]))
job=next(item for item in plan["jobs"] if item["job_key"]==sys.argv[2])
print(",".join(str(value) for value in job["snapshot_minutes"]))
PY
    )
    command=(
      "$PYTHON" -u "$ROOT/src/exact_pricer_expanded.py"
      --csv "$INSTANCE_REL" --prices_csv hourly_prices_flat.csv
      --g-kwh 300 --charge-kw 300 --min-soc-frac 0
      --soc-step 15 --block-min 10
      --master-sense partition --initial-pool singletons
      --wall-limit-s "$((BUDGET - 300))"
      --checkpoint-every 25 --resume
      --snapshot-at-minutes "$SNAPSHOTS"
      --phase-telemetry "$TELEMETRY"
      --out "$OUTPUT"
    )
    ;;
  MIP)
    CG_OUTPUT=$(
      "$PYTHON" -I -B - "$PLAN" "$JOB_KEY" <<'PY'
import json,sys
plan=json.load(open(sys.argv[1]))
job=next(item for item in plan["jobs"] if item["job_key"]==sys.argv[2])
dependency=job["dependency_cg"]
print(next(item["output"] for item in plan["jobs"] if item["job_key"]==dependency))
PY
    )
    [[ -s "$CG_OUTPUT" ]] || fatal "dependent CG status missing"
    export GRB_LICENSE_FILE=/share/apps/software/gurobi/gurobi.lic
    unset LM_LICENSE_FILE || true
    [[ -r "$GRB_LICENSE_FILE" ]] || fatal "Gurobi license missing"
    JOURNAL=$(
      "$PYTHON" -I -B - "$CG_OUTPUT" <<'PY'
import json,pathlib,sys
status=json.load(open(sys.argv[1]))
path=pathlib.Path(status["columns_journal"])
if not path.is_absolute():
    path=pathlib.Path(sys.argv[1]).resolve().parent/path
print(path.resolve())
PY
    )
    [[ -s "$JOURNAL" ]] || fatal "dependent CG journal missing"
    export EVSP_MIP_EXPECTED_RESULT_SHA256
    EVSP_MIP_EXPECTED_RESULT_SHA256=$(sha256sum "$CG_OUTPUT" | awk '{print $1}')
    export EVSP_MIP_EXPECTED_JOURNAL_SHA256
    EVSP_MIP_EXPECTED_JOURNAL_SHA256=$(sha256sum "$JOURNAL" | awk '{print $1}')
    command=(
      "$PYTHON" -u "$ROOT/src/run_exact_pool_mip.py"
      --result "$CG_OUTPUT" --two-stage --threads "$THREADS"
      --timelimit "$BUDGET" --mipgap 0.0001
      --progress-dir "$PROGRESS" --out "$OUTPUT"
    )
    if [[ "$ARM" == "KNOWN-PARTITION" ]]; then
      SEED_OUTPUT=$(
        "$PYTHON" -I -B - "$PLAN" "$JOB_KEY" <<'PY'
import json,sys
plan=json.load(open(sys.argv[1]))
job=next(item for item in plan["jobs"] if item["job_key"]==sys.argv[2])
dependency=job["dependency_seed"]
print(next(item["output"] for item in plan["jobs"] if item["job_key"]==dependency))
PY
      )
      [[ -s "$SEED_OUTPUT" ]] || fatal "known partition missing"
      export EVSP_MIP_EXPECTED_INITIAL_PARTITION_SHA256
      EVSP_MIP_EXPECTED_INITIAL_PARTITION_SHA256=$(
        sha256sum "$SEED_OUTPUT" | awk '{print $1}'
      )
      command+=(
        --initial-partition-routes "$SEED_OUTPUT"
      )
    else
      unset EVSP_MIP_EXPECTED_INITIAL_PARTITION_SHA256 || true
    fi
    ;;
  *)
    fatal "unknown phase"
    ;;
esac

child=""
forward_signal() {
  if [[ -n "$child" ]]; then
    kill -USR1 "$child" 2>/dev/null || true
  fi
}
trap forward_signal USR1 TERM INT
cd "$ROOT"
"${command[@]}" &
child=$!
status=0
while true; do
  wait_status=0
  wait "$child" || wait_status=$?
  if kill -0 "$child" 2>/dev/null; then
    continue
  fi
  status=$wait_status
  break
done
child=""
trap - USR1 TERM INT
[[ "$status" -eq 0 ]] || fatal "cell command failed: $status"

"$PYTHON" -I -B - "$OUTPUT" "$PHASE" "$PROGRESS" "$TELEMETRY" \
  "$PLAN_SHA" "$INSTANCE_SHA" <<'PY' \
  || fatal "completion publication failed"
import hashlib,json,os,pathlib,sys
output,phase,progress,telemetry,plan_sha,instance_sha=sys.argv[1:]
output=pathlib.Path(output)
paths=[]
if output.is_dir():
    paths.extend(path for path in output.rglob("*") if path.is_file())
else:
    paths.append(output)
if phase=="CG":
    paths.extend([
        pathlib.Path(str(output)+".columns.jsonl"),
        pathlib.Path(str(output)+".iters.csv"),
        pathlib.Path(telemetry),
    ])
if phase=="MIP":
    paths.extend(
        path for path in pathlib.Path(progress).rglob("*") if path.is_file()
    )
if not paths or any(not path.is_file() for path in paths):
    raise SystemExit("incomplete completion artifact set")
def sha(path):
    digest=hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda:handle.read(1024*1024),b""):
            digest.update(chunk)
    return digest.hexdigest()
payload={
    "schema":"evsp-dr-scale-ladder-worker-completion-v1",
    "phase":phase,
    "plan_sha256":plan_sha,
    "instance_file_sha256":instance_sha,
    "artifact_sha256":{
        str(path.resolve()):sha(path) for path in sorted(set(paths))
    },
}
target=pathlib.Path(str(output)+".worker-completion.json")
temporary=target.with_name(f".{target.name}.tmp.{os.getpid()}")
with temporary.open("x") as handle:
    json.dump(payload,handle,sort_keys=True,separators=(",",":"))
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
try:
    os.link(temporary,target)
finally:
    temporary.unlink(missing_ok=True)
PY
echo "[SCALE-LADDER] DONE $JOB_KEY scale=$SCALE selection=$SELECTION_REP cg=$CG_REP"
