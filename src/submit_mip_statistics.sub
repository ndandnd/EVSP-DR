#!/bin/bash
# Hash-bound worker for one strict MIP convergence-statistics cell.
#SBATCH --job-name=MSTAT-UNSET
#SBATCH --partition=scaglione
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=04:10:00
#SBATCH --no-requeue
#SBATCH --signal=B:USR1@180
#SBATCH --open-mode=append
#SBATCH --mail-type=FAIL,TIME_LIMIT
#SBATCH --mail-user=nc437@cornell.edu

set -euo pipefail
WORKER_START_NS=$(date +%s%N)

fatal() {
  echo "[MIP-STATS] FATAL: $*" >&2
  exit 2
}

[[ "$#" -eq 3 ]] \
  || fatal "usage: $0 APPROVED_PLAN EXPECTED_PLAN_SHA256 CELL_ID"
PLAN=$1
EXPECTED_PLAN_SHA=$2
REQUESTED_CELL=$3
ROOT=${EVSP_DR_ROOT:?EVSP_DR_ROOT is required}
EXPECTED_COMMIT=${EVSP_EXPECTED_COMMIT:?EVSP_EXPECTED_COMMIT is required}
EXPECTED_WORKER_SHA=${EVSP_MIP_EXPECTED_WORKER_SHA256:?worker hash required}

worker_sha=$(sha256sum "$0" | awk '{print $1}')
[[ "$worker_sha" == "$EXPECTED_WORKER_SHA" ]] || fatal "worker hash mismatch"
plan_sha=$(sha256sum "$PLAN" | awk '{print $1}')
[[ "$plan_sha" == "$EXPECTED_PLAN_SHA" ]] || fatal "approved plan hash mismatch"
observed_commit=$(git -C "$ROOT" rev-parse --verify HEAD) \
  || fatal "cannot resolve Git HEAD"
[[ "$observed_commit" == "$EXPECTED_COMMIT" ]] || fatal "commit mismatch"
if git -C "$ROOT" symbolic-ref -q HEAD >/dev/null 2>&1; then
  fatal "MIP statistics checkout must be detached"
else
  symbolic_status=$?
  [[ "$symbolic_status" -eq 1 ]] || fatal "cannot verify detached checkout"
fi
tracked=$(git -C "$ROOT" status --porcelain --untracked-files=no) \
  || fatal "cannot verify tracked checkout"
[[ -z "$tracked" ]] || fatal "checkout has tracked modifications"
untracked_imports=$(git -C "$ROOT" status --porcelain --untracked-files=all \
  | awk '$1 == "??" && $2 ~ /\\.(py|pth|so|sub)$/ {print}')
[[ -z "$untracked_imports" ]] \
  || fatal "checkout has untracked importable worker code"

PYTHON=${EVSP_MIP_PYTHON:-}
if [[ -z "$PYTHON" ]]; then
  PYTHON=$(command -v python) || fatal "python is unavailable"
fi
export PYTHONDONTWRITEBYTECODE=1
"$PYTHON" -I -B - "$ROOT" <<'PY' \
  || fatal "checkout contains ignored/importable runtime artifacts"
import os,pathlib,subprocess,sys
root=pathlib.Path(sys.argv[1]).resolve()
tracked_result=subprocess.run(
    ["git","ls-files","-z"],cwd=root,capture_output=True,check=False
)
if tracked_result.returncode != 0:
    raise SystemExit("cannot enumerate tracked files")
tracked={
    value.decode()
    for value in tracked_result.stdout.split(b"\0") if value
}
unsafe=[]
for scan_root in (root,root/"src"):
    if not scan_root.exists():
        continue
    for current,dirs,files in os.walk(scan_root):
        current_path=pathlib.Path(current)
        excluded={".git","results","logs"}
        if current_path == root:
            excluded.add("src")
        retained=[]
        for name in dirs:
            path=current_path/name
            relative=str(path.relative_to(root))
            if name in excluded:
                continue
            if name == "__pycache__" or path.is_symlink():
                unsafe.append(relative)
                continue
            retained.append(name)
        dirs[:]=retained
        for name in files:
            path=current_path/name
            relative=str(path.relative_to(root))
            suffix=path.suffix.lower()
            if path.is_symlink():
                unsafe.append(relative)
            elif suffix in {".pyc",".pyo",".so",".pth"}:
                unsafe.append(relative)
            elif suffix == ".py" and relative not in tracked:
                unsafe.append(relative)
if unsafe:
    raise SystemExit(f"unsafe runtime artifacts: {sorted(set(unsafe))[:10]}")
PY
"$PYTHON" -c \
  'import sys, gurobipy; assert sys.version_info[:2] == (3, 12)' \
  || fatal "Python 3.12/Gurobi environment unavailable"
"$PYTHON" - "$PLAN" <<'PY' || fatal "worker environment differs from plan"
import json,os,sys
plan=json.load(open(sys.argv[1]))
for key,value in (plan.get("environment_whitelist") or {}).items():
    if os.environ.get(key) != str(value):
        raise SystemExit(f"{key} mismatch")
PY
observed_environment=$(
  "$PYTHON" "$ROOT/src/mip_statistics_environment.py"
) || fatal "could not compute MIP environment identity"
"$PYTHON" - "$PLAN" "$observed_environment" <<'PY' \
  || fatal "MIP environment identity differs from plan"
import json,sys
observed=json.loads(sys.argv[2])
plan=json.load(open(sys.argv[1]))
if observed != plan.get("python_identity"):
    raise SystemExit("environment identity mismatch")
PY

readarray -t FIELDS < <("$PYTHON" - "$PLAN" "$REQUESTED_CELL" <<'PY'
import json,os,sys
plan=json.load(open(sys.argv[1]))
requested=sys.argv[2]
jobs=plan.get("jobs",[])
if requested == "__ARRAY__":
    raw_index=os.environ.get("SLURM_ARRAY_TASK_ID","")
    if not raw_index.isdigit():
        raise SystemExit("array worker lacks a valid task index")
    index=int(raw_index)
    matches=[jobs[index]] if 0 <= index < len(jobs) else []
else:
    matches=[job for job in jobs if job.get("cell_id")==requested]
if len(matches)!=1:
    raise SystemExit("approved plan does not contain exactly one requested cell")
d=matches[0].get("execution")
if not isinstance(d,dict):
    raise SystemExit("approved cell lacks execution descriptor")
for key in (
    "cell_id","arm","time_limit_s","threads","mip_gap",
    "status","status_sha256","journal","journal_sha256",
    "instance","instance_sha256","instance_relative",
    "tariff","tariff_sha256","tariff_relative",
    "validated_start","validated_start_sha256","output","progress_dir",
    "matrix","source_label","source_master_sense","source_initial_pool",
):
    value=d.get(key)
    print("" if value is None else value)
for value in (
    plan.get("runner_sha256"), plan.get("worker_sha256"),
    (plan.get("checkout_identity") or {}).get("expected_commit"),
    (plan.get("python_identity") or {}).get("executable_sha256"),
):
    print("" if value is None else value)
PY
)
CELL=${FIELDS[0]}
ARM=${FIELDS[1]}
TIME_LIMIT=${FIELDS[2]}
THREADS=${FIELDS[3]}
MIP_GAP=${FIELDS[4]}
STATUS=${FIELDS[5]}
STATUS_SHA=${FIELDS[6]}
JOURNAL=${FIELDS[7]}
JOURNAL_SHA=${FIELDS[8]}
INSTANCE=${FIELDS[9]}
INSTANCE_SHA=${FIELDS[10]}
INSTANCE_REL=${FIELDS[11]}
TARIFF=${FIELDS[12]}
TARIFF_SHA=${FIELDS[13]}
TARIFF_REL=${FIELDS[14]}
START=${FIELDS[15]}
START_SHA=${FIELDS[16]}
OUT=${FIELDS[17]}
PROGRESS=${FIELDS[18]}
MATRIX=${FIELDS[19]}
SOURCE_LABEL=${FIELDS[20]}
SOURCE_MASTER_SENSE=${FIELDS[21]}
SOURCE_INITIAL_POOL=${FIELDS[22]}
RUNNER_SHA=${FIELDS[23]}
SPEC_WORKER_SHA=${FIELDS[24]}
SPEC_COMMIT=${FIELDS[25]}
PYTHON_SHA=${FIELDS[26]}

[[ "$SPEC_COMMIT" == "$EXPECTED_COMMIT" ]] || fatal "spec commit mismatch"
[[ "$SPEC_WORKER_SHA" == "$EXPECTED_WORKER_SHA" ]] \
  || fatal "spec worker hash mismatch"
[[ "$ARM" == "RAW" || "$ARM" == "GIRO" \
  || "$ARM" == "GIRO40-AUGMENTED" ]] || fatal "invalid arm"
[[ "$THREADS" == "8" ]] || fatal "statistics campaign requires 8 threads"
if [[ "$REQUESTED_CELL" == "__ARRAY__" ]]; then
  [[ "${SLURM_ARRAY_TASK_ID:-}" =~ ^[0-3]$ ]] \
    || fatal "array task index is invalid"
else
  [[ "$CELL" == "$REQUESTED_CELL" ]] || fatal "cell descriptor mismatch"
fi
[[ "$INSTANCE_REL" != /* && "$INSTANCE_REL" != *".."* ]] \
  || fatal "unsafe instance relative path"
[[ "$TARIFF_REL" != /* && "$TARIFF_REL" != *".."* ]] \
  || fatal "unsafe tariff relative path"

verify_hash() {
  local label=$1 path=$2 expected=$3
  [[ -f "$path" ]] || fatal "$label missing: $path"
  local actual
  actual=$(sha256sum "$path" | awk '{print $1}')
  [[ "$actual" == "$expected" ]] || fatal "$label hash mismatch"
}
verify_hash "status" "$STATUS" "$STATUS_SHA"
verify_hash "journal" "$JOURNAL" "$JOURNAL_SHA"
verify_hash "instance" "$INSTANCE" "$INSTANCE_SHA"
verify_hash "tariff" "$TARIFF" "$TARIFF_SHA"
verify_hash "approved plan" "$PLAN" "$EXPECTED_PLAN_SHA"
verify_hash "worker" "$0" "$SPEC_WORKER_SHA"
verify_hash "runner" "$ROOT/src/run_exact_pool_mip.py" "$RUNNER_SHA"
verify_hash "staged runner" \
  "$(dirname "$PLAN")/input/run_exact_pool_mip.py" "$RUNNER_SHA"
verify_hash "approved Python" "$PYTHON" "$PYTHON_SHA"
while IFS=$'\t' read -r relative expected; do
  verify_hash "checkout code $relative" "$ROOT/$relative" "$expected"
  verify_hash "staged code $relative" \
    "$(dirname "$PLAN")/input/reviewed_code/$relative" "$expected"
done < <("$PYTHON" - "$PLAN" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))
for path,digest in sorted((d.get("code_hashes") or {}).items()):
    print(f"{path}\t{digest}")
PY
)
if [[ "$ARM" == "GIRO" || "$ARM" == "GIRO40-AUGMENTED" ]]; then
  [[ -n "$START" && -n "$START_SHA" ]] || fatal "GIRO arm lacks start"
  verify_hash "validated start" "$START" "$START_SHA"
else
  [[ -z "$START" && -z "$START_SHA" ]] || fatal "RAW arm received a start"
fi
if [[ "$MATRIX" == "raw_k40" || "$MATRIX" == "raw_k40_smoke" ]]; then
  [[ "$ARM" == "RAW" ]] || fatal "raw_k40 cell is not RAW"
  if [[ "$MATRIX" == "raw_k40_smoke" ]]; then
    [[ "$TIME_LIMIT" == "1800" ]] \
      || fatal "raw_k40 smoke budget is not thirty minutes"
  else
    [[ "$TIME_LIMIT" == "28800" ]] \
      || fatal "raw_k40 budget is not eight hours"
  fi
  [[ "$SOURCE_LABEL" =~ ^R[12]_C[AS]$ ]] \
    || fatal "raw_k40 source label is invalid"
  [[ "$SOURCE_MASTER_SENSE" == "cover" ]] \
    || fatal "raw_k40 source master is not cover"
  case "$SOURCE_LABEL:$SOURCE_INITIAL_POOL" in
    R1_CA:artificial|R2_CA:artificial|R1_CS:singletons|R2_CS:singletons) ;;
    *) fatal "raw_k40 source initializer/label mismatch" ;;
  esac
fi
if [[ "$MATRIX" == "k40_cs_overnight" ]]; then
  [[ "$SOURCE_LABEL" =~ ^R[12]_CS$ ]] \
    || fatal "overnight source label is not R1_CS/R2_CS"
  [[ "$SOURCE_MASTER_SENSE" == "cover" \
    && "$SOURCE_INITIAL_POOL" == "singletons" ]] \
    || fatal "overnight source treatment changed"
  if [[ "$ARM" == "RAW" ]]; then
    [[ "$TIME_LIMIT" == "28800" ]] \
      || fatal "overnight RAW budget is not eight hours"
  elif [[ "$ARM" == "GIRO40-AUGMENTED" ]]; then
    [[ "$TIME_LIMIT" == "7200" ]] \
      || fatal "overnight GIRO40 budget is not two hours"
  else
    fatal "overnight arm lacks scientific treatment label"
  fi
fi
[[ ! -e "$OUT" ]] || fatal "output already exists"
[[ ! -e "$PROGRESS" ]] || fatal "progress directory already exists"

"$PYTHON" "$ROOT/src/install_exact_cg_profile_input.py" \
  --source "$INSTANCE" --data-root "$ROOT/data" \
  --relative "$INSTANCE_REL" --sha256 "$INSTANCE_SHA" \
  || fatal "instance installation failed"
"$PYTHON" "$ROOT/src/install_exact_cg_profile_input.py" \
  --source "$TARIFF" --data-root "$ROOT/data" \
  --relative "$TARIFF_REL" --sha256 "$TARIFF_SHA" \
  || fatal "tariff installation failed"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export GRB_LICENSE_FILE=/share/apps/software/gurobi/gurobi.lic
unset LM_LICENSE_FILE || true
export EVSP_EXPECTED_COMMIT="$EXPECTED_COMMIT"
export EVSP_REQUIRE_DETACHED=1
export EVSP_MIP_EXPECTED_RESULT_SHA256="$STATUS_SHA"
export EVSP_MIP_EXPECTED_JOURNAL_SHA256="$JOURNAL_SHA"
if [[ "$ARM" == "GIRO" || "$ARM" == "GIRO40-AUGMENTED" ]]; then
  export EVSP_MIP_EXPECTED_INITIAL_PARTITION_SHA256="$START_SHA"
else
  unset EVSP_MIP_EXPECTED_INITIAL_PARTITION_SHA256 || true
fi

command=(
  "$PYTHON" -u "$ROOT/src/run_exact_pool_mip.py"
  --result "$STATUS"
  --two-stage
  --timelimit "$TIME_LIMIT"
  --threads "$THREADS"
  --mipgap "$MIP_GAP"
  --progress-dir "$PROGRESS"
  --out "$OUT"
)
if [[ "$ARM" == "GIRO" || "$ARM" == "GIRO40-AUGMENTED" ]]; then
  command+=(--initial-partition-routes "$START")
fi

echo "[MIP-STATS] cell=$CELL arm=$ARM host=$(hostname) job=${SLURM_JOB_ID:-none}"
cd "$ROOT"
solver_pid=""
forward_warning() {
  if [[ -n "$solver_pid" ]]; then
    kill -USR1 "$solver_pid" 2>/dev/null || true
  fi
}
trap forward_warning USR1 TERM INT
"${command[@]}" &
solver_pid=$!
solver_rc=0
while true; do
  wait_rc=0
  wait "$solver_pid" || wait_rc=$?
  if kill -0 "$solver_pid" 2>/dev/null; then
    continue
  fi
  solver_rc=$wait_rc
  break
done
solver_pid=""
trap - USR1 TERM INT
[[ "$solver_rc" -eq 0 ]] || fatal "solver exited with status $solver_rc"

if ! "$PYTHON" - "$OUT" "$PROGRESS" "$STATUS_SHA" "$JOURNAL_SHA" \
    "$ARM" "$MATRIX" "$TIME_LIMIT" "$SOURCE_LABEL" <<'PY'
import hashlib, json, math, pathlib, sys
out, progress, status_sha, journal_sha, arm, matrix, time_limit, source_label = sys.argv[1:]
d=json.load(open(out))
if d.get("partitioning") is not True:
    raise SystemExit("result is not strict partitioning")
if d.get("source_result_sha256") != status_sha:
    raise SystemExit("result status hash mismatch")
if d.get("source_journal_sha256") != journal_sha:
    raise SystemExit("result journal hash mismatch")
if arm in {"GIRO", "GIRO40-AUGMENTED"}:
    start=d.get("mip_start") or {}
    if start.get("kind") != "validated_exact_partition":
        raise SystemExit("GIRO result lacks validated exact start")
if matrix in {"raw_k40", "raw_k40_smoke"}:
    start=d.get("mip_start") or {}
    arguments=(d.get("mip_provenance") or {}).get("arguments") or {}
    if arm != "RAW":
        raise SystemExit("raw_k40 result is not RAW")
    if start.get("kind") not in {"none", "greedy_pool_partition"}:
        raise SystemExit("raw_k40 result used a prohibited start")
    if start.get("source") is not None or start.get("source_sha256") is not None:
        raise SystemExit("raw_k40 result records an external start")
    if d.get("extra_route_sources") != []:
        raise SystemExit("raw_k40 result contains extra routes")
    if arguments.get("initial_partition_routes") is not None:
        raise SystemExit("raw_k40 runner received an initial partition")
    if (
        arguments.get("cover") is not False
        or arguments.get("two_stage") is not True
        or int(arguments.get("timelimit", -1)) != int(time_limit)
    ):
        raise SystemExit("raw_k40 solver arguments changed")
    if int(d.get("source_snapshot_mark_minutes", -1)) != 1440:
        raise SystemExit("raw_k40 result does not use the 24-hour pool")
    physical=d.get("physical_pool_audit") or {}
    if (
        int(physical.get("rejected_columns", -1)) != 0
        or int(physical.get("accepted_columns", -1))
        != int(physical.get("total_columns", -2))
    ):
        raise SystemExit("raw_k40 physical pool gate rejected columns")
    if not math.isfinite(float(
        d.get("physical_pool_preparation_wall_s", math.nan)
    )):
        raise SystemExit("raw_k40 preprocessing time is missing")
    if not math.isfinite(float(
        d.get("gurobi_optimize_wall_s", math.nan)
    )):
        raise SystemExit("raw_k40 Gurobi time is missing")
    if d.get("continuous_cost_pricing_certified") is not False:
        raise SystemExit("continuous-cost pricing certificate was claimed")
if not pathlib.Path(progress, "final.json").is_file():
    raise SystemExit("progress final.json is missing")
if d.get("incumbent_found"):
    counts={}
    source=json.load(open(d["source_result"]))
    for route in d.get("selected_routes") or []:
        blocks=route.get("continuous_realized_charging_blocks")
        physical=route.get("physical_realization") or {}
        if not isinstance(blocks, list):
            raise SystemExit("selected route lacks continuous blocks")
        encoded=json.dumps(
            blocks, sort_keys=True, separators=(",", ":")
        ).encode()
        if hashlib.sha256(encoded).hexdigest() != physical.get(
            "continuous_realized_charging_blocks_sha256"
        ):
            raise SystemExit("selected route block hash mismatch")
        if physical.get(
            "continuous_realized_charging_blocks_schema"
        ) != "evsp-dr-continuous-realized-charging-blocks-v1":
            raise SystemExit("selected route block schema mismatch")
        for block in blocks:
            required={
                "station", "start_min", "end_min", "realized_kwh",
                "expanded_grid_kwh", "tariff_hour", "tariff_key",
                "price_per_kwh",
            }
            if not required <= set(block):
                raise SystemExit("selected route block fields missing")
        for trip in route.get("trips") or []:
            counts[trip]=counts.get(trip,0)+1
    if set(counts) != set(source["trip_ids"]):
        raise SystemExit("selected routes have wrong trip set")
    if any(counts[trip] != 1 for trip in source["trip_ids"]):
        raise SystemExit("selected routes are not exact once-only")
elif source_label.endswith("_CA") and d.get("status_name") == "INFEASIBLE":
    # A proved finite-pool infeasibility is a valid CA smoke outcome.
    pass
elif matrix == "raw_k40_smoke":
    raise SystemExit(
        "smoke result lacks a physical incumbent and is not CA INFEASIBLE"
    )
PY
then
  fatal "result validation failed"
fi
if [[ "$MATRIX" == "k40_cs_overnight" ]]; then
  "$PYTHON" "$ROOT/src/validate_k40_cs_overnight_result.py" \
    --result "$OUT" --progress-dir "$PROGRESS" --arm "$ARM" \
    --time-limit-s "$TIME_LIMIT" --source-label "$SOURCE_LABEL" \
    || fatal "overnight result validation failed"
fi
"$PYTHON" - "$PROGRESS" "$OUT" "$WORKER_START_NS" "$STATUS_SHA" \
  "$JOURNAL_SHA" "$ARM" <<'PY' \
  || fatal "worker completion publication failed"
import hashlib,json,os,pathlib,sys,time
progress,result_path,start_ns,status_sha,journal_sha,arm=sys.argv[1:]
progress_path=pathlib.Path(progress)
result_path=pathlib.Path(result_path)
def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()
progress_hashes={
    path.name:sha(path)
    for path in sorted([
        *progress_path.glob("checkpoint_*.json"),
        progress_path/"final.json",
        progress_path/"latest.json",
    ])
}
payload={
    "schema":"evsp-dr-mip-worker-completion-v2",
    "true_end_to_end_wall_s":(time.time_ns()-int(start_ns))/1e9,
    "source_result_sha256":status_sha,
    "source_journal_sha256":journal_sha,
    "arm":arm,
    "result_sha256":sha(result_path),
    "progress_artifact_sha256":progress_hashes,
    "progress_set_sha256":hashlib.sha256(json.dumps(
        progress_hashes,sort_keys=True,separators=(",",":")
    ).encode()).hexdigest(),
    "result_and_progress_validation_passed":True,
}
path=progress_path/"worker_completion.json"
with path.open("x") as handle:
    json.dump(payload,handle,sort_keys=True,separators=(",",":"))
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
PY
echo "[MIP-STATS] DONE cell=$CELL output=$OUT progress=$PROGRESS"
