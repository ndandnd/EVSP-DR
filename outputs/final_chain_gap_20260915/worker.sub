#!/bin/bash
set -euo pipefail
unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH LM_LICENSE_FILE
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONHASHSEED=0
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export GRB_LICENSE_FILE=/share/apps/software/gurobi/gurobi.lic
# Usage: worker.sub ROOT CASE_ID. A requeue receives a private restart directory.
if [[ ${1:-} == --root ]]; then
    ROOT=${2:?campaign root is required}
    [[ ${3:-} == --case ]] || { echo 'Expected --case CASE_ID' >&2; exit 2; }
    CASE=${4:?case id is required}
else
    ROOT=${1:?campaign root is required}
    CASE=${2:?case id is required}
fi
/home/nc437/evsp_env/bin/python - <<'PY'
import gurobipy as gp
m = gp.Model('overnight_diagnostics_license')
m.Params.OutputFlag = 0
m.Params.Threads = 1
x = m.addVars(2001, lb=0, ub=1, obj=1)
m.addConstr(x.sum() >= 1)
m.optimize()
assert m.Status == gp.GRB.OPTIMAL
m.dispose()
print('Native Gurobi license check passed', flush=True)
PY
exec /home/nc437/evsp_env/bin/python -u "$ROOT/worker.py" --root "$ROOT" --case "$CASE"
