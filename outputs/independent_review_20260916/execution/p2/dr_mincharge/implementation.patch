+"""Zero-fee terminal-energy graph with minimum-duration controllable charging.
+
+Graph cost prices grid energy. Continuous schedules uniformly spread only their
+required energy over the entire selected window, at power <= station maximum.
+Zero-energy station visits are waits, not charging starts. No continuous-cost
+optimality claim follows from the graph LP certificate.
+"""
+import math
+import json
+from copy import deepcopy
+from terminal_energy_pricer import TerminalEnergyNetwork
+from expanded_path_realization import _tariff_identity, validate_continuous_charging_blocks
+from config import BUS_COST_KX
+
+
+def full_window_blocks(record, prices, maximum_kw, minimum_minutes):
+    r = deepcopy(record)
+    actual = r['charging_stops']; grid = r['expanded_grid_charging_stops']
+    blocks=[];active=idle=0
+    for i,station in enumerate(actual['stations']):
+        start,end=float(grid['cst'][i]),float(grid['cet'][i]);duration=end-start
+        energy=float(actual['kwh'][i]);expanded=float(grid['kwh'][i])
+        if duration < minimum_minutes-1e-8:
+            raise ValueError('Graph charging window violates minimum duration')
+        if energy < -1e-8 or energy > expanded+1e-6:
+            raise ValueError('Continuous energy must lie within grid energy')
+        if energy*60/duration > maximum_kw+1e-6 or expanded*60/duration > maximum_kw+1e-6:
+            raise ValueError('Charging power exceeds station maximum')
+        actual['cst'][i]=start;actual['cet'][i]=end
+        active += energy>1e-9;idle += energy<=1e-9
+        cursor=start;index=0
+        while cursor < end-1e-10:
+            stop=min(end,(math.floor(cursor/60)+1)*60);fraction=(stop-cursor)/duration
+            blocks.append(dict(stop_index=i,block_index=index,station=station,start_min=cursor,end_min=stop,
+                               realized_kwh=energy*fraction,expanded_grid_kwh=expanded*fraction,
+                               **_tariff_identity(station,cursor,prices)))
+            cursor=stop;index+=1
+    continuous=BUS_COST_KX+sum(b['realized_kwh']*b['price_per_kwh'] for b in blocks)
+    grid_cost=BUS_COST_KX+sum(b['expanded_grid_kwh']*b['price_per_kwh'] for b in blocks)
+    if not math.isclose(grid_cost,r['cost'],abs_tol=1e-5,rel_tol=1e-10):
+        raise ValueError('Minimum-duration realization changed graph cost')
+    r.update(continuous_realized_charging_blocks=blocks,continuous_realized_cost=continuous,
+             active_charge_start_count=active,idle_station_visit_count=idle,
+             minimum_active_charge_minutes=minimum_minutes,
+             continuous_power_policy='constant controllable power within each full grid window; 0 <= p <= maximum_kw',
+             continuous_cost_pricing_certified=False)
+    audit=validate_continuous_charging_blocks(r,blocks,station_prices=prices,charge_kw=maximum_kw,
+                                        expected_continuous_cost=continuous)
+    r['continuous_realized_charging_blocks_json_bytes']=len(json.dumps(blocks,sort_keys=True,separators=(',',':')))
+    physical=r.setdefault('physical_realization',{})
+    physical['continuous_realized_charging_blocks_sha256']=audit['block_schedule_sha256']
+    physical['charging_profile_schema']='evsp-uniform-controllable-full-window-v1'
+    physical['minimum_active_charge_minutes']=minimum_minutes
+    physical['zero_energy_visits']='idle; excluded from active charge starts'
+    return r
+
+
+class MinimumChargeNetwork(TerminalEnergyNetwork):
+    def __init__(self,*args,minimum_charge_minutes=3,**kwargs):
+        self.minimum_charge_minutes=float(minimum_charge_minutes)
+        if self.minimum_charge_minutes<0:raise ValueError('Negative minimum charge duration')
+        super().__init__(*args,**kwargs)
+
+    def _charge_candidates(self,*args,**kwargs):
+        for target,cost,successor,action in super()._charge_candidates(*args,**kwargs):
+            if action['cet']-action['cst'] >= self.minimum_charge_minutes-1e-8:
+                yield target,cost,successor,action
+
+    def _record(self,actions):
+        record=super()._record(actions)
+        return full_window_blocks(record,self.prices,self.charge_kw,self.minimum_charge_minutes)
