diff --git a/tests/test_minimum_charge_pricer.py b/tests/test_minimum_charge_pricer.py
new file mode 100644
index 00000000..aa2366be
--- /dev/null
+++ b/tests/test_minimum_charge_pricer.py
@@ -0,0 +1,33 @@
+import sys,unittest
+from pathlib import Path
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'src'))
+import config
+config.CHARGE_START_COST=0.0
+from minimum_charge_pricer import MinimumChargeNetwork,full_window_blocks
+from terminal_duplicate_cleanup import frontier
+from test_event_pricer_network import two_trip_problem,prices,STATION
+from expanded_path_realization import _tariff_identity
+
+class MinimumChargeTest(unittest.TestCase):
+ def test_full_window_spread_crosses_tariff_boundary_and_idle(self):
+  p=prices();base=STATION.rsplit('_',1)[0];p[base][0]=1;p[base][1]=3
+  stations=[STATION,STATION];stops=dict(stations=stations,cst=[59,70],cet=[62,73],kwh=[6,0]);grid={**stops,'kwh':[12,12]}
+  price0=_tariff_identity(STATION,59,p)['price_per_kwh'];price1=_tariff_identity(STATION,60,p)['price_per_kwh']
+  cost=config.BUS_COST_KX+4*price0+20*price1
+  r=full_window_blocks(dict(charging_stops=stops,expanded_grid_charging_stops=grid,cost=cost),p,240,3)
+  self.assertEqual(r['active_charge_start_count'],1);self.assertEqual(r['idle_station_visit_count'],1)
+  self.assertAlmostEqual(r['continuous_realized_cost'],config.BUS_COST_KX+2*price0+4*price1)
+  self.assertEqual([b['realized_kwh'] for b in r['continuous_realized_charging_blocks']],[2,4,0])
+ def test_graph_pricing_and_fixed_frontier_share_minimum(self):
+  for mode in ['explicit','lazy']:
+   net=MinimumChargeNetwork(two_trip_problem(145.4),prices(),soc_step=2.5,block_min=5,g_kwh=240,charge_kw=240,reserve_kwh=0,arc_mode=mode,fixed_sequence_index=True,minimum_charge_minutes=3)
+   fixed=frontier(net,[0,1]);self.assertTrue(fixed)
+   result=net.terminal_batch({0:100001,1:100001},limit=30)
+   self.assertTrue(result);self.assertEqual(result[0]['record']['trips'],[0,1])
+   self.assertAlmostEqual(result[0]['rc'],min(r['cost']-200002 for r in fixed),places=5)
+   for r in fixed+[x['record'] for x in result]:
+    for a,b,e in zip(r['charging_stops']['cst'],r['charging_stops']['cet'],r['charging_stops']['kwh']):
+     if e>1e-9:self.assertGreaterEqual(b-a,3-1e-8)
+     self.assertLessEqual(e*60/(b-a),240+1e-6)
+    self.assertAlmostEqual(sum(b['realized_kwh'] for b in r['continuous_realized_charging_blocks']),sum(r['charging_stops']['kwh']),places=6)
+if __name__=='__main__':unittest.main()
