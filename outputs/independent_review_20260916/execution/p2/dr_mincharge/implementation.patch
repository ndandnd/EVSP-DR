+ save(out/'columns.json',routes)
+ result=dict(graph_seconds=graph_seconds,frontier_seconds=time.monotonic()-started,frontier_complete=complete,duty_count=len(duties),processed_duties=len(progress),infeasible_duties=[x['duty_id'] for x in progress if not x['alternatives']],terminal_target_kwh=a.target,fleet_cap=a.fleet_cap,physics=dict(battery_kwh=240,charge_kw=240,reserve_kwh=0,minimum_charge_minutes=3,charge_start_fee=0,capacity='unconstrained',continuous_power='uniform controllable over full grid window'),input_hashes={str(f):sha(f) for f in [data/a.csv,Path(a.prices),Path(a.master),data/'Ref_dict.csv',data/'par_ref_dhd.csv']},columns_sha256=sha(out/'columns.json'),interpretation='Fixed trip sequences; complete terminal-energy frontiers in same discretized graph as joint CG. Grid-objective finite-pool proof distinct from continuous repriced cost.')
+ selected=[]
+ if complete and not result['infeasible_duties']:
+  solved,selected=solve(routes,problem.trips,target=a.target,cap=a.fleet_cap,seconds=a.mip_seconds,log_dir=out,threads=8);result.update(solved)
+ if selected:
+  result.update(selected_active_charge_starts=sum(r['active_charge_start_count'] for r in selected),selected_idle_station_visits=sum(r['idle_station_visit_count'] for r in selected),selected_terminal_kwh=sum(r['terminal_energy_kwh'] for r in selected),selected_continuous_terminal_kwh=sum(r['continuous_terminal_energy_kwh'] for r in selected),selected_continuous_charging_cost=sum(r['continuous_realized_cost']-BUS_COST_KX for r in selected))
+ save(out/'selected_routes.json',selected);save(out/'summary.json',result)
+if __name__=='__main__':main()
