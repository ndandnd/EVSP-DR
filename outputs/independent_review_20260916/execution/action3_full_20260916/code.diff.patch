diff --git a/tests/test_action3_compact.py b/tests/test_action3_compact.py
new file mode 100644
index 00000000..1514053f
--- /dev/null
+++ b/tests/test_action3_compact.py
@@ -0,0 +1,35 @@
+import sys,unittest
+from pathlib import Path
+from types import SimpleNamespace
+import pandas as pd
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'src'))
+from audit_giro_known_columns import ProblemData,STATIONS
+from run_capacity_speed_event_cg import build_network
+from event_pricer_network import _best_charge_window,_charge_window_options
+from utils_v2 import base_station_name
+class CompactTest(unittest.TestCase):
+ def test_flat_shortcut_matches_reference_enumeration(self):
+  for kw in [60,240]:
+   for arrival,end in [(59.5,150),(70,130),(70,71)]:
+    for energy in [2.5,60,120]:
+     args=dict(event_times={'PARX_1':list(range(0,1600,5))},station_prices={'PARX':{i:0.13 for i in range(27)}},charge_kw=kw)
+     expected=_charge_window_options('PARX_1',arrival,end,energy,**args)
+     actual=_best_charge_window('PARX_1',arrival,end,energy,**args)
+     self.assertEqual(actual is None,not expected)
+     if actual:self.assertAlmostEqual(actual[0],min(expected)[0],places=9)
+ def test_compact_preserves_fixed_sequences_and_reduced_cost_without_capacity(self):
+  p=ProblemData(pd.DataFrame(),(0,1),{'PARX_0':[(0,0.,0.,'depot_trip'),(1,0.,0.,'depot_trip')],0:[(1,0.,0.,'trip_trip'),('PARX_1',0.,0.,'trip_station'),('PARX_0',0.,0.,'trip_depot')],'PARX_1':[(1,0.,0.,'station_trip'),('PARX_0',0.,0.,'station_depot')],1:[('PARX_0',0.,0.,'trip_depot')]},{0:60.,1:130.},{0:70.,1:140.},{0:150.,1:150.})
+  prices={base_station_name(s):{i:0.1 for i in range(27)} for s in STATIONS}
+  for battery,reserve,arm in [(240,0,'baseline'),(240,0,'parx60'),(240,36,'baseline'),(236.44,0,'baseline'),(239.01,0,'baseline')]:
+   args=SimpleNamespace(soc_step=2.5,block_min=5,battery_kwh=battery,non_parx_kw=240,reserve_kwh=reserve,arm=arm)
+   args.network_arc_mode='explicit';explicit=build_network(args,p,prices)
+   args.network_arc_mode='lazy';compact=build_network(args,p,prices)
+   for seq in [(0,),(1,),(0,1)]:
+    a=explicit.fixed_sequence_record(seq);b=compact.fixed_sequence_record(seq)
+    self.assertEqual(a is None,b is None)
+    if a:self.assertAlmostEqual(a['cost'],b['cost'])
+   for dual in [{0:100000,1:100000},{0:50000,1:70000},{0:200001,1:0}]:
+    self.assertAlmostEqual(explicit.min_reduced_cost_route(dual)['rc'],compact.min_reduced_cost_route(dual)['rc'],places=6)
+ def test_capacity_cannot_use_compact_station_dominance(self):
+  with self.assertRaisesRegex(ValueError,'capacity duals'):build_network(SimpleNamespace(arm='capacity',network_arc_mode='lazy'),None,None)
+if __name__=='__main__':unittest.main()
