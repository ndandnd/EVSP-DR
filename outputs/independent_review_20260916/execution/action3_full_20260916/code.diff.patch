+"""Hash-gated compact graph cache for the six no-capacity sensitivity arms."""
+import json,os,pickle,time
+from pathlib import Path
+from run_capacity_speed_event_cg import ARMS,sha256_file,atomic_json
+from config import BUS_COST_KX,CHARGE_START_COST,charge_cost_premium
+from audit_giro_known_columns import HORIZON_MIN
+def cache_identity(args,prov):
+ return {'schema':'action3-event-network-v1',**{k:prov[k] for k in ['git_commit','instance_sha256','prices_sha256','reference_sha256','deadhead_sha256']},
+ 'battery_kwh':float(args.battery_kwh),'reserve_kwh':float(args.reserve_kwh),'non_parx_kw':float(args.non_parx_kw),
+ 'parx_kw':ARMS[args.arm]['parx_kw'],'capacity':ARMS[args.arm]['capacity'],'soc_step':args.soc_step,'block_min':args.block_min,
+ 'max_station_wait_min':args.max_station_wait_min,'arc_mode':args.network_arc_mode,'tariff_coverage_strict':False,
+ 'horizon_min':HORIZON_MIN,'bus_cost':BUS_COST_KX,'charge_start_cost':CHARGE_START_COST,'charge_cost_premium':charge_cost_premium}
+def write_cache(path,network,identity,build_s):
+ path=Path(path);path.parent.mkdir(parents=True,exist_ok=True)
+ if path.exists() or Path(str(path)+'.manifest.json').exists():raise FileExistsError('refusing to replace a graph cache')
+ temp=path.with_name('.'+path.name+f'.{os.getpid()}.tmp')
+ with open(temp,'wb') as f:pickle.dump(network,f,protocol=pickle.HIGHEST_PROTOCOL);f.flush();os.fsync(f.fileno())
+ os.replace(temp,path)
+ m={'identity':identity,'pickle_sha256':sha256_file(path),'pickle_bytes':path.stat().st_size,'network_metrics':network.metrics(),'build_s':build_s}
+ atomic_json(Path(str(path)+'.manifest.json'),m);return m
+def load_cache(path,expected):
+ from event_pricer_network import EventExpandedNetwork
+ path=Path(path);m=json.loads(Path(str(path)+'.manifest.json').read_text())
+ if m['identity']!=expected:raise ValueError('network-cache physics/input/code identity mismatch')
+ if sha256_file(path)!=m['pickle_sha256']:raise ValueError('network-cache bytes hash mismatch')
+ with open(path,'rb') as f:net=pickle.load(f)
+ if not isinstance(net,EventExpandedNetwork) or net.metrics()!=m['network_metrics']:raise ValueError('network-cache type/metrics mismatch')
+ return net,m
