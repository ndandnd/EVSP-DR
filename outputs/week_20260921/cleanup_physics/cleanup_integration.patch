+++ b/tests/test_terminal_dispatch_postprocess.py
@@ -0,0 +1,40 @@
+import json
+from pathlib import Path
+import pytest
+from terminal_dispatch_postprocess import postprocess_selected_dispatch
+from terminal_cleanup_settings import UnsupportedConfiguration
+
+
+def source(tmp_path, **physics_extra):
+    s={'terminal_target_kwh':0,'fleet_cap':1,'physics':dict(battery_kwh=240,
+       initial_kwh=240,charge_kw=350,reserve_kwh=0,soc_step=2.5,time_step=5,
+       shared_capacity=False,charge_start_fee=5,coverage='cover',**physics_extra)}
+    (tmp_path/'summary.json').write_text(json.dumps(s))
+    (tmp_path/'selected_routes.json').write_text('[{"trips":[1]}]')
+    return (tmp_path/'summary.json').read_bytes()
+
+
+def test_missing_incumbent_skips_without_calling_solver(tmp_path):
+    (tmp_path/'summary.json').write_text('{}')
+    def fail(*a,**kw): raise AssertionError('must not invoke solver')
+    r=postprocess_selected_dispatch(tmp_path,runner=fail)
+    assert r['status']=='skipped_no_integer_incumbent'
+
+
+def test_nonlinear_physics_rejected_before_running(tmp_path):
+    source(tmp_path,piecewise_charging=True)
+    with pytest.raises(UnsupportedConfiguration):
+        postprocess_selected_dispatch(tmp_path,runner=lambda *a,**k: pytest.fail())
+
+
+def test_dispatch_receipt_preserves_sources_and_service_assignment(tmp_path):
+    original=source(tmp_path)
+    def solver(argv,check):
+        assert check and '--selected-source-sha256' in argv
+        out=Path(argv[argv.index('--out')+1]);out.mkdir()
+        (out/'summary.json').write_text(json.dumps({'outcome':'unchanged_dispatch_fallback'}))
+    r=postprocess_selected_dispatch(tmp_path,seconds=12,threads=2,runner=solver)
+    assert (tmp_path/'summary.json').read_bytes()==original
+    assert r['usable_dispatch'] and r['status']=='unchanged_dispatch_fallback'
+    assert 'service_trips' in r['note']
+    with pytest.raises(FileExistsError):postprocess_selected_dispatch(tmp_path,runner=solver)
