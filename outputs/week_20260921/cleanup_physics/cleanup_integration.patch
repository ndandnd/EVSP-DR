diff --git a/src/terminal_dispatch_postprocess.py b/src/terminal_dispatch_postprocess.py
new file mode 100644
index 00000000..91883fd7
--- /dev/null
+++ b/src/terminal_dispatch_postprocess.py
@@ -0,0 +1,57 @@
+"""Opt-in final dispatch cleanup, leaving CG/MIP source evidence immutable."""
+from pathlib import Path
+import hashlib
+import json
+import subprocess
+import sys
+
+from terminal_cleanup_settings import settings_from_summary
+
+
+def postprocess_selected_dispatch(output_directory, *, seconds=600, threads=1,
+                                  runner=None):
+    """Publish an exact-once dispatch or an explicit failure receipt.
+
+    Only the cleanup backend's declared constant-power configurations pass its
+    fail-closed settings parser. Raw selected routes and their solver summary
+    are never overwritten or relabeled as a cleaned dispatch.
+    """
+    output = Path(output_directory).resolve()
+    source = output / 'summary.json'
+    source_bytes = source.read_bytes()
+    source_hash = hashlib.sha256(source_bytes).hexdigest()
+    selected = output / 'selected_routes.json'
+    receipt_path = output / 'dispatch_cleanup_receipt.json'
+    if not selected.exists():
+        receipt = {'status': 'skipped_no_integer_incumbent',
+                   'source_summary_sha256': source_hash}
+    else:
+        if seconds <= 0 or threads < 1:
+            raise ValueError('cleanup seconds and threads must be positive')
+        summary = json.loads(source_bytes)
+        settings_from_summary(summary)  # Reject unsupported physics before launch.
+        destination = output / 'dispatch_cleanup'
+        if destination.exists():
+            raise FileExistsError('Refusing to overwrite an earlier dispatch cleanup')
+        command = [sys.executable, str(Path(__file__).with_name(
+            'terminal_duplicate_cleanup.py')), '--source', str(source),
+            '--source-sha256', source_hash, '--selected-source-sha256',
+            hashlib.sha256(selected.read_bytes()).hexdigest(), '--out',
+            str(destination), '--seconds', str(seconds), '--threads', str(threads)]
+        execute = subprocess.run if runner is None else runner
+        execute(command, check=True)
+        result = json.loads((destination / 'summary.json').read_text())
+        if source.read_bytes() != source_bytes:
+            raise RuntimeError('Cleanup unexpectedly mutated its source summary')
+        accepted = result['outcome'] in ('repaired', 'unchanged_dispatch_fallback')
+        receipt = {'status': result['outcome'], 'usable_dispatch': accepted,
+                   'source_summary_sha256': source_hash,
+                   'summary': str(destination / 'summary.json'),
+                   'dispatch': str(destination / 'dispatch.json') if accepted else None,
+                   'selected_routes': str(destination / 'selected_routes.json') if accepted else None,
+                   'validation': str(destination / 'validation.json'),
+                   'source_routes_preserved': True,
+                   'note': 'Use dispatch.service_trips for passenger assignment; '
+                           'route.trips can retain redundant empty driving in a fallback.'}
+    receipt_path.write_text(json.dumps(receipt, indent=2) + '\n')
+    return receipt
