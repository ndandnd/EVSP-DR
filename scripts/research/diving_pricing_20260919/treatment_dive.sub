#!/bin/bash
# Treatment arm: identity-verified cache load + diving-with-pricing + the
# trusted pool MIP on the augmented pool, inside ONE wall budget.
#
#   sbatch --partition=default_partition --exclude=scaglione-compute-01 \
#          --cpus-per-task=8 --mem=96G --time=<wall> \
#          treatment_dive.sub <work> <case_id>
#
# ONE treatment job per case. Both budget arms share the same treatment
# run (3,600 s of real compute either way); they differ only in what the
# CONTROL is given and in how the graph build is charged. collect.py
# pairs this single run against both control rows.
#
# Budget bookkeeping (preregistered, see PREREGISTRATION.md):
#   total  = cache load + dive + final MIP  <=  treatment_total_s
#   dive   <= treatment_dive_wall_limit_s
#   MIP    =  max(mip_floor_s, total - elapsed_so_far)
# Every component is measured and written to timing.json, including the cache
# load, so the graph cost is never silently excluded.
set -euo pipefail
unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH LM_LICENSE_FILE
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONHASHSEED=0
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export GRB_LICENSE_FILE=/share/apps/software/gurobi/gurobi.lic

WORK=$1; CASE=$2
MANIFEST=$WORK/manifest.json
PY=$(python3 - "$MANIFEST" <<'PYEOF'
import json,sys; print(json.load(open(sys.argv[1]))['python'])
PYEOF
)
read -r CODE MIP_COMMIT DIVE_COMMIT RESULT RESULT_SHA JOURNAL JOURNAL_SHA CACHE \
        TOTAL DIVE_LIMIT MIP_FLOOR SEED THREADS RC_EPS CPI MAXIT NODET MAXNODES ALTS RESTARTS \
  < <($PY - "$MANIFEST" "$CASE" <<'PYEOF'
import json, sys
m = json.load(open(sys.argv[1])); c = m['cases'][sys.argv[2]]; p = m['preregistered']
# The treatment budget is identical under both arms by construction.
b = c['budget']['arm_a_shared_prerequisite']
assert b['treatment_total_s'] == c['budget']['arm_b_graph_charged']['treatment_total_s']
print(m['code'], m['mip_execution_commit'], m['execution_commit'],
      c['fresh_cg_result'], c['fresh_cg_result_sha256'],
      c['fresh_journal'], c['fresh_journal_sha256'],
      c['event_network_cache'],
      b['treatment_total_s'],
      b['treatment_dive_wall_limit_s'], b['treatment_mip_floor_s'],
      p['seed'], p['mip_threads'], p['rc_eps'], p['columns_per_iter'],
      p['max_pricing_iters'], p['node_time_s'], p['max_nodes'],
      p['max_alternatives'], p['max_restarts'])
PYEOF
)
DIVE=$CODE/src/diving_pricing_pilot.py
# See control_mip.sub: the pool MIP comes from the pinned checkout.
MIP=$CODE/src/run_exact_pool_mip.py

test "$(sha256sum "$RESULT"  | cut -d' ' -f1)" = "$RESULT_SHA"
test "$(sha256sum "$JOURNAL" | cut -d' ' -f1)" = "$JOURNAL_SHA"

OUT=$WORK/results/$CASE/treatment/${SLURM_JOB_ID}_r${SLURM_RESTART_COUNT:-0}
mkdir -p "$OUT/dive"
START_EPOCH=$(date +%s)
START=$(date -u +%Y-%m-%dT%H:%M:%SZ)
cat > "$OUT/execution.json" <<JSON
{"track":"diving_pricing_20260919","case_id":"$CASE","arm":"treatment",
 "slurm_job_id":"$SLURM_JOB_ID","restart_count":"${SLURM_RESTART_COUNT:-0}",
 "host":"$(hostname -f)","started_utc":"$START",
 "result":"$RESULT","result_sha256":"$RESULT_SHA",
 "journal":"$JOURNAL","journal_sha256":"$JOURNAL_SHA",
 "cache":"$CACHE","dive_commit":"$DIVE_COMMIT","mip_commit":"$MIP_COMMIT",
 "treatment_total_s":"$TOTAL","status":"running"}
JSON

# ---- stage 1: cache load + dive (one process; it measures its own split) ---
cd "$CODE"
DIVE_ARGV=("$PY" "$DIVE" --result "$RESULT" --out-dir "$OUT/dive"
           --data-dir "$CODE/data" --fleet-cap 8
           --wall-limit-s "$DIVE_LIMIT" --reserve-s 60
           --event-network-cache "$CACHE" --cache-commit-bridge
           --seed "$SEED" --rc-eps "$RC_EPS" --columns-per-iter "$CPI"
           --max-pricing-iters "$MAXIT" --node-time-s "$NODET"
           --max-nodes "$MAXNODES" --max-alternatives "$ALTS"
           --max-restarts "$RESTARTS"
           --gurobi-log "$OUT/dive/gurobi.log")
printf '%s\n' "${DIVE_ARGV[@]}" > "$OUT/dive_argv.txt"
set +e
"${DIVE_ARGV[@]}" > "$OUT/dive_stdout.log" 2> "$OUT/dive_stderr.log"
DIVE_RC=$?
set -e
DIVE_DONE_EPOCH=$(date +%s)

# The frozen source must be untouched before anything else runs.
test "$(sha256sum "$RESULT"  | cut -d' ' -f1)" = "$RESULT_SHA"
test "$(sha256sum "$JOURNAL" | cut -d' ' -f1)" = "$JOURNAL_SHA"

AUG=$OUT/dive/cg.json
AUG_JOURNAL=$OUT/dive/cg.json.columns.jsonl
AUG_SHA=$(sha256sum "$AUG" | cut -d' ' -f1)
AUG_JOURNAL_SHA=$(sha256sum "$AUG_JOURNAL" | cut -d' ' -f1)

# ---- stage 2: the trusted pool MIP on the augmented pool -------------------
ELAPSED=$((DIVE_DONE_EPOCH - START_EPOCH))
MIP_TL=$((TOTAL - ELAPSED))
if [ "$MIP_TL" -lt "$MIP_FLOOR" ]; then MIP_TL=$MIP_FLOOR; fi
STAGE1_TL=$((MIP_TL / 2))
export EVSP_EXPECTED_COMMIT=$MIP_COMMIT EVSP_REQUIRE_DETACHED=1 \
       EVSP_MIP_EXPECTED_RESULT_SHA256=$AUG_SHA \
       EVSP_MIP_EXPECTED_JOURNAL_SHA256=$AUG_JOURNAL_SHA
MIP_ARGV=("$PY" "$MIP" --result "$AUG" --data-dir "$CODE/data"
          --reference-data-dir "$CODE/data" --cover --two-stage
          --timelimit "$MIP_TL" --stage1-timelimit "$STAGE1_TL"
          --threads "$THREADS" --mipgap 0.0001 --seed "$SEED"
          --gurobi-log "$OUT/mip_gurobi.log" --out "$OUT/result.json")
printf '%s\n' "${MIP_ARGV[@]}" > "$OUT/mip_argv.txt"
set +e
"${MIP_ARGV[@]}" > "$OUT/mip_stdout.log" 2> "$OUT/mip_stderr.log"
MIP_RC=$?
set -e
END_EPOCH=$(date +%s)
END=$(date -u +%Y-%m-%dT%H:%M:%SZ)

test "$(sha256sum "$RESULT"  | cut -d' ' -f1)" = "$RESULT_SHA"
test "$(sha256sum "$JOURNAL" | cut -d' ' -f1)" = "$JOURNAL_SHA"

$PY - "$OUT" "$DIVE_RC" "$MIP_RC" "$END" "$START_EPOCH" "$DIVE_DONE_EPOCH" \
      "$END_EPOCH" "$MIP_TL" "$AUG_SHA" "$AUG_JOURNAL_SHA" <<'PYEOF'
import json, sys
from pathlib import Path
out = Path(sys.argv[1])
dive_manifest = json.loads((out / 'dive' / 'manifest.json').read_text())
cache = dive_manifest.get('network_cache_audit', {})
timing = {
    'schema': 'evsp-dr-diving-pricing-timing-v1',
    'cache_io_s': cache.get('cache_io_s'),
    'cache_hash_s': cache.get('hash_s'),
    'cache_unpickle_s': cache.get('unpickle_s'),
    'cache_pickle_bytes': cache.get('pickle_bytes'),
    'cache_original_build_s': cache.get('original_build_s'),
    'commit_bridge_used': cache.get('commit_bridge_used'),
    'dive_stage_s': int(sys.argv[6]) - int(sys.argv[5]),
    'dive_internal_wall_s': dive_manifest.get('wall_s'),
    'dive_stop_reason': dive_manifest['dive']['stop_reason'],
    'dive_nodes': dive_manifest['dive']['nodes'],
    'columns_generated': dive_manifest['dive']['columns_generated'],
    'dive_integer_solution': dive_manifest['dive']['integer_solution'],
    'mip_timelimit_s': int(sys.argv[8]),
    'mip_stage_s': int(sys.argv[7]) - int(sys.argv[6]),
    'total_stage_s': int(sys.argv[7]) - int(sys.argv[5]),
    'augmented_result_sha256': sys.argv[9],
    'augmented_journal_sha256': sys.argv[10],
    'source_immutable': dive_manifest['source']['source_immutable'],
    'global_certificate': None,
}
(out / 'timing.json').write_text(json.dumps(timing, indent=1))
p = out / 'execution.json'
d = json.loads(p.read_text())
d.update(status='finished' if sys.argv[3] == '0' else 'failed',
         dive_returncode=int(sys.argv[2]), mip_returncode=int(sys.argv[3]),
         ended_utc=sys.argv[4], timing=timing, source_immutable=True)
p.write_text(json.dumps(d, indent=1))
print(json.dumps(timing, indent=1))
PYEOF
exit $MIP_RC
