#!/bin/bash
set -euo pipefail
unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
: "${EVSP_EXECUTION_REPO:?}" "${EVSP_EXPECTED_COMMIT:?}" "${EVSP_CAMPAIGN_ROOT:?}" "${EVSP_PLAN_SHA256:?}" "${EVSP_POOL_MATRIX_SHA256:?}"
PYTHON_BIN="${EVSP_PYTHON:-$HOME/evsp_env/bin/python}"; FREEZER="$EVSP_EXECUTION_REPO/src/freeze_terminal_exact_cg_pool.py"
[[ "$(git -C "$EVSP_EXECUTION_REPO" rev-parse HEAD)" == "$EVSP_EXPECTED_COMMIT" ]]
[[ -z "$(git -C "$EVSP_EXECUTION_REPO" status --porcelain --untracked-files=no)" ]]
[[ "$(sha256sum "$EVSP_CAMPAIGN_ROOT/execution_plan.json"|awk '{print $1}')" == "$EVSP_PLAN_SHA256" ]]
[[ "$(sha256sum "$EVSP_CAMPAIGN_ROOT/pool_matrix.tsv"|awk '{print $1}')" == "$EVSP_POOL_MATRIX_SHA256" ]]
read -r WORKER_SHA FREEZER_SHA < <("$PYTHON_BIN" - "$EVSP_CAMPAIGN_ROOT/execution_plan.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))['code_sha256']
print(d['scripts/event_uniform_envelope/nested_threshold_freeze.sub'],d['src/freeze_terminal_exact_cg_pool.py'])
PY
)
[[ "$(sha256sum "$0"|awk '{print $1}')" == "$WORKER_SHA" ]]
[[ "$(sha256sum "$FREEZER"|awk '{print $1}')" == "$FREEZER_SHA" ]]
LINE=$(sed -n "$((SLURM_ARRAY_TASK_ID+2))p" "$EVSP_CAMPAIGN_ROOT/pool_matrix.tsv")
IFS=$'\t' read -r INDEX CELL SCALE REPLICATE TRIPS REP INSTANCE_REL INSTANCE_SHA SOURCE _SAME SNAPSHOT RECORD MIP_OUT <<< "$LINE"
[[ "$INDEX" == "$SLURM_ARRAY_TASK_ID" ]]
[[ ! -e "$RECORD" ]] || { echo "existing freeze record requires explicit audit: $RECORD" >&2; exit 2; }
for p in "$SNAPSHOT" "$SNAPSHOT.columns.jsonl" "$SNAPSHOT.iters.csv"; do [[ ! -e "$p" ]] || { echo "partial snapshot: $p" >&2; exit 2; }; done
exec "$PYTHON_BIN" -u "$FREEZER" --base-status "$SOURCE" --resume-status "$SOURCE" --cell "$CELL" --instance-relative-to-data "$INSTANCE_REL" --instance-sha256 "$INSTANCE_SHA" --source-solver-commit "$EVSP_EXPECTED_COMMIT" --out "$SNAPSHOT" --record "$RECORD"
