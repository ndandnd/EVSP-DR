#!/bin/bash
set -euo pipefail

unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

: "${EVSP_EXECUTION_REPO:?}"
: "${EVSP_CAMPAIGN_ROOT:?}"
: "${EVSP_EXPECTED_COMMIT:?}"
PYTHON_BIN="${EVSP_PYTHON:-$HOME/evsp_env/bin/python}"
[[ "$(git -C "$EVSP_EXECUTION_REPO" rev-parse HEAD)" == "$EVSP_EXPECTED_COMMIT" ]]
[[ -z "$(git -C "$EVSP_EXECUTION_REPO" status --porcelain)" ]]

LINE=$(sed -n "$((SLURM_ARRAY_TASK_ID + 1))p" "$EVSP_CAMPAIGN_ROOT/matrix.tsv")
IFS=$'\t' read -r INDEX CELL SCALE REPLICATE TRIPS CSV_PATH CSV_SHA REP SOC BLOCK WALL <<< "$LINE"
[[ "$INDEX" == "$SLURM_ARRAY_TASK_ID" ]]
[[ "$(sha256sum "$CSV_PATH" | awk '{print $1}')" == "$CSV_SHA" ]]
CACHE="$EVSP_CAMPAIGN_ROOT/network_cache/M__${CELL}__${REP}.pkl"

cd "$EVSP_EXECUTION_REPO"
exec "$PYTHON_BIN" -u src/exact_pricer_expanded.py \
  --csv "$CSV_PATH" --prices_csv hourly_prices_flat.csv \
  --time-model event --event-arc-mode lazy \
  --event-network-cache "$CACHE" --event-network-cache-only \
  --soc-step "$SOC" --block-min "$BLOCK" \
  --g-kwh 240 --charge-kw 240 --min-soc-frac 0
