#!/bin/bash
set -euo pipefail
unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export GRB_LICENSE_FILE=/share/apps/software/gurobi/gurobi.lic; unset LM_LICENSE_FILE || true
: "${EVSP_EXECUTION_REPO:?}" "${EVSP_EXPECTED_COMMIT:?}" "${EVSP_CAMPAIGN_ROOT:?}" "${EVSP_PLAN_SHA256:?}" "${EVSP_POOL_MATRIX_SHA256:?}"
PYTHON_BIN="${EVSP_PYTHON:-$HOME/evsp_env/bin/python}"; RUNNER="$EVSP_EXECUTION_REPO/src/run_exact_pool_mip.py"
[[ "${SLURM_RESTART_COUNT:-0}" == 0 ]] || { echo "MIP tree restart is unsupported" >&2; exit 2; }
[[ "$(git -C "$EVSP_EXECUTION_REPO" rev-parse HEAD)" == "$EVSP_EXPECTED_COMMIT" ]]
[[ -z "$(git -C "$EVSP_EXECUTION_REPO" status --porcelain --untracked-files=no)" ]]
source "$EVSP_EXECUTION_REPO/scripts/event_uniform_envelope/gurobi_worker_preflight.sh"
[[ "$(sha256sum "$EVSP_CAMPAIGN_ROOT/execution_plan.json"|awk '{print $1}')" == "$EVSP_PLAN_SHA256" ]]
[[ "$(sha256sum "$EVSP_CAMPAIGN_ROOT/pool_matrix.tsv"|awk '{print $1}')" == "$EVSP_POOL_MATRIX_SHA256" ]]
read -r WORKER_SHA RUNNER_SHA < <("$PYTHON_BIN" - "$EVSP_CAMPAIGN_ROOT/execution_plan.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))['code_sha256']
print(d['scripts/event_uniform_envelope/heavy_threshold_mip.sub'],d['src/run_exact_pool_mip.py'])
PY
)
[[ "$(sha256sum "$0"|awk '{print $1}')" == "$WORKER_SHA" ]]
[[ "$(sha256sum "$RUNNER"|awk '{print $1}')" == "$RUNNER_SHA" ]]
LINE=$(sed -n "$((SLURM_ARRAY_TASK_ID+2))p" "$EVSP_CAMPAIGN_ROOT/pool_matrix.tsv")
IFS=$'\t' read -r INDEX CELL SCALE REPLICATE TRIPS REP INSTANCE_REL INSTANCE_SHA SOURCE _SAME SNAPSHOT RECORD OUT <<< "$LINE"
[[ "$INDEX" == "$SLURM_ARRAY_TASK_ID" && -s "$RECORD" ]]
read -r SNAPSHOT_SHA JOURNAL_SHA < <("$PYTHON_BIN" - "$RECORD" "$CELL" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); assert d["cell"]==sys.argv[2]
print(d["snapshot_sha256"],d["journal_sha256"])
PY
)
[[ "$(sha256sum "$SNAPSHOT"|awk '{print $1}')" == "$SNAPSHOT_SHA" ]]
[[ "$(sha256sum "$SNAPSHOT.columns.jsonl"|awk '{print $1}')" == "$JOURNAL_SHA" ]]
[[ ! -e "$OUT" ]] || { echo "existing MIP result requires explicit audit: $OUT" >&2; exit 2; }
[[ ! -e "$OUT.rejected_physical_replay.json" ]] || { echo "physical replay rejection exists" >&2; exit 2; }
PROGRESS="$EVSP_CAMPAIGN_ROOT/progress/$CELL"
[[ ! -e "$PROGRESS" ]] || { echo "censored prior MIP progress requires explicit fresh-attempt directory" >&2; exit 2; }
printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "${SLURM_JOB_ID:-}" "${SLURM_ARRAY_TASK_ID:-}" "$(hostname -s)" fresh_tree >> "$OUT.allocations.tsv"
export EVSP_EXPECTED_COMMIT EVSP_REQUIRE_DETACHED=1 EVSP_MIP_EXPECTED_RESULT_SHA256="$SNAPSHOT_SHA" EVSP_MIP_EXPECTED_JOURNAL_SHA256="$JOURNAL_SHA"
cd "$EVSP_EXECUTION_REPO"
MIP_LIMIT=28800
STAGE_ARGS=()
if (( SCALE > 5 )); then MIP_LIMIT=3600; STAGE_ARGS=(--fleet-timelimit 1800 --cost-timelimit 1800 --allow-unproven-fleet-cost); fi
exec "$PYTHON_BIN" -u "$RUNNER" --result "$SNAPSHOT" --data-dir "$EVSP_EXECUTION_REPO/data" --reference-data-dir "$EVSP_EXECUTION_REPO/data" --require-singleton-partition --timelimit "$MIP_LIMIT" "${STAGE_ARGS[@]}" --mipgap 0.0001 --threads 8 --two-stage --progress-dir "$PROGRESS" --gurobi-log "$OUT.gurobi.log" --out "$OUT"
