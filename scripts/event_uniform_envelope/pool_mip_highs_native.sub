#!/bin/bash
set -euo pipefail

unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

: "${EVSP_EXECUTION_REPO:?}"
: "${EVSP_EXPECTED_COMMIT:?}"
: "${EVSP_PANEL:?}"
: "${EVSP_INTEGER_MANIFEST:?}"
: "${EVSP_HIGHS_OUTPUT_DIR:?}"
PYTHON_BIN="${EVSP_PYTHON:-$HOME/evsp_env/bin/python}"
[[ "$(git -C "$EVSP_EXECUTION_REPO" rev-parse HEAD)" == "$EVSP_EXPECTED_COMMIT" ]]
[[ -z "$(git -C "$EVSP_EXECUTION_REPO" status --porcelain)" ]]

LINE=$(sed -n "$((SLURM_ARRAY_TASK_ID + 2))p" "$EVSP_INTEGER_MANIFEST")
IFS=$'\t' read -r INDEX CELL TARGET REP SOURCE STATUS_SHA JOURNAL JOURNAL_SHA <<< "$LINE"
[[ "$INDEX" == "$SLURM_ARRAY_TASK_ID" ]]
[[ "$(sha256sum "$SOURCE" | awk '{print $1}')" == "$STATUS_SHA" ]]
[[ "$(sha256sum "$JOURNAL" | awk '{print $1}')" == "$JOURNAL_SHA" ]]
OUT="$EVSP_HIGHS_OUTPUT_DIR/${EVSP_PANEL}__${CELL}__${REP}.json"
[[ ! -e "$OUT" ]]

export EVSP_REQUIRE_DETACHED=1
cd "$EVSP_EXECUTION_REPO"
exec "$PYTHON_BIN" -u src/run_exact_pool_mip_highs.py \
  --result "$SOURCE" --solver native --timelimit 1800 \
  --mipgap 0.0001 --threads 8 --out "$OUT"
