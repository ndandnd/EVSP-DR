#!/bin/bash
set -euo pipefail
unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
: "${EVSP_EXECUTION_REPO:?}" "${EVSP_EXPECTED_COMMIT:?}" "${EVSP_CAMPAIGN_ROOT:?}" "${EVSP_PLAN_SHA256:?}" "${EVSP_MATRIX_SHA256:?}"
PYTHON_BIN="${EVSP_PYTHON:-$HOME/evsp_env/bin/python}"
[[ "$(git -C "$EVSP_EXECUTION_REPO" rev-parse HEAD)" == "$EVSP_EXPECTED_COMMIT" ]]
[[ -z "$(git -C "$EVSP_EXECUTION_REPO" status --porcelain --untracked-files=no)" ]]
[[ "$(sha256sum "$EVSP_CAMPAIGN_ROOT/execution_plan.json"|awk '{print $1}')" == "$EVSP_PLAN_SHA256" ]]
[[ "$(sha256sum "$EVSP_CAMPAIGN_ROOT/matrix.tsv"|awk '{print $1}')" == "$EVSP_MATRIX_SHA256" ]]
read -r EXPECTED SOLVER_SHA < <("$PYTHON_BIN" - "$EVSP_CAMPAIGN_ROOT/execution_plan.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))['code_sha256']
print(d['scripts/event_uniform_envelope/nested_threshold_cache.sub'],d['src/exact_pricer_expanded.py'])
PY
)
[[ "$(sha256sum "$0"|awk '{print $1}')" == "$EXPECTED" ]]
[[ "$(sha256sum "$EVSP_EXECUTION_REPO/src/exact_pricer_expanded.py"|awk '{print $1}')" == "$SOLVER_SHA" ]]
LINE=$(sed -n "$((SLURM_ARRAY_TASK_ID+1))p" "$EVSP_CAMPAIGN_ROOT/matrix.tsv")
IFS=$'\t' read -r INDEX CELL SCALE REPLICATE TRIPS CSV_PATH CSV_SHA REP SOC BLOCK WALL <<< "$LINE"
[[ "$INDEX" == "$SLURM_ARRAY_TASK_ID" && "$(sha256sum "$CSV_PATH"|awk '{print $1}')" == "$CSV_SHA" ]]
CACHE="$EVSP_CAMPAIGN_ROOT/network_cache/M__${CELL}__${REP}.pkl"
cd "$EVSP_EXECUTION_REPO"
exec "$PYTHON_BIN" -u src/exact_pricer_expanded.py --csv "$CSV_PATH" --prices_csv hourly_prices_flat.csv --time-model event --event-arc-mode lazy --event-network-cache "$CACHE" --event-network-cache-only --soc-step "$SOC" --block-min "$BLOCK" --g-kwh 240 --charge-kw 240 --min-soc-frac 0
