#!/bin/bash
set -euo pipefail
unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
: "${EVSP_EXECUTION_REPO:?}" "${EVSP_EXPECTED_COMMIT:?}" "${EVSP_CAMPAIGN_ROOT:?}" "${EVSP_MATRIX_SHA256:?}"
PYTHON_BIN="${EVSP_PYTHON:-$HOME/evsp_env/bin/python}"
[[ "$(git -C "$EVSP_EXECUTION_REPO" rev-parse HEAD)" == "$EVSP_EXPECTED_COMMIT" ]]
[[ -z "$(git -C "$EVSP_EXECUTION_REPO" status --porcelain --untracked-files=no)" ]]
[[ "$(sha256sum "$EVSP_CAMPAIGN_ROOT/matrix.tsv"|awk '{print $1}')" == "$EVSP_MATRIX_SHA256" ]]
source "$EVSP_EXECUTION_REPO/scripts/event_uniform_envelope/gurobi_worker_preflight.sh"
read -r WORKER_SHA SOLVER_SHA < <("$PYTHON_BIN" - "$EVSP_CAMPAIGN_ROOT/execution_plan.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))['code_sha256']
print(d['scripts/event_uniform_envelope/legacy_selected10_cg.sub'],d['src/exact_pricer_expanded.py'])
PY
)
[[ "$(sha256sum "$0"|awk '{print $1}')" == "$WORKER_SHA" ]]
[[ "$(sha256sum "$EVSP_EXECUTION_REPO/src/exact_pricer_expanded.py"|awk '{print $1}')" == "$SOLVER_SHA" ]]
LINE=$(sed -n "$((SLURM_ARRAY_TASK_ID+1))p" "$EVSP_CAMPAIGN_ROOT/matrix.tsv")
IFS=$'\t' read -r INDEX CELL SCALE REPLICATE TRIPS CSV_PATH CSV_SHA REP SOC BLOCK WALL G_KWH CHARGE_KW <<< "$LINE"
[[ "$INDEX" == "$SLURM_ARRAY_TASK_ID" && "$(sha256sum "$CSV_PATH" | awk '{print $1}')" == "$CSV_SHA" ]]
CACHE="$EVSP_CAMPAIGN_ROOT/network_cache/M__${CELL}__${REP}.pkl"; OUT="$EVSP_CAMPAIGN_ROOT/cg/M__${CELL}__${REP}.json"
RESUME=(); [[ -e "$OUT" || -e "$OUT.columns.jsonl" || -e "$OUT.iters.csv" ]] && RESUME=(--resume)
printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "${SLURM_JOB_ID:-}" "${SLURM_RESTART_COUNT:-0}" "$(hostname -s)" "$([[ ${#RESUME[@]} -gt 0 ]]&&echo resume||echo fresh)" >> "$OUT.allocations.tsv"
export EVSP_REQUIRE_DETACHED=1; cd "$EVSP_EXECUTION_REPO"
exec "$PYTHON_BIN" -u src/exact_pricer_expanded.py --csv "$CSV_PATH" --prices_csv hourly_prices_flat.csv --time-model event --event-arc-mode lazy --event-network-cache "$CACHE" --event-network-cache-mode require --soc-step "$SOC" --block-min "$BLOCK" --max-iters 50000 --columns_per_iter 30 --column-selection reduced_cost --column-diversity-weight 0.0 --column-candidate-multiplier 4 --rc-eps 0.0001 --master-sense partition --master-backend gurobi --initial-pool singletons --wall-limit-s "$WALL" --checkpoint-every 25 --g-kwh "$G_KWH" --charge-kw "$CHARGE_KW" --min-soc-frac 0 --phase-telemetry "$OUT.phase-telemetry.jsonl" --gurobi-log "$OUT.gurobi.log" --out "$OUT" "${RESUME[@]}"
